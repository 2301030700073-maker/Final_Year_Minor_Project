.venv/
__pycache__/
*.pyc
.env
.pytest_cache/
# Test/coverage run artifacts - regenerated on every `pytest` run, never source.
# Same class as the bundle bloat below (an artifact a stray `git add .` would
# otherwise commit); .pytest-tmp is this project's TMPDIR for pytest.
.coverage
.pytest-tmp/
# Generated analysis/reports/audit output - never commit (a stray `git add .`
# would otherwise sweep the full audit history + APK analysis into the repo).
outputs/
*.objection.apk
*-debuggable.apk
tools/objection_cache/
*.apk

# L-M6: Ghidra install is a build artifact, never committed (~1GB extracted)
tools/ghidra/
# L-M1: the CFR secondary-decompiler jar is a documented download (see README),
# pinned on the reference box, not vendored into git
tools/cfr/
# Reference-box tooling binaries: version-pinned downloads (see README), never committed
tools/frida-server-*
tools/jadx/

# A1: per-bundle decompiled APK trees. collect_verification_bundle.py copies the
# full jadx/apktool `analysis/` output into each handoff bundle; that subtree is
# regenerable decompiler output (duplicated across every timestamped bundle of the
# same APK) and accounts for ~630k tracked files / ~7.6 GB - the exact repo bloat
# `outputs/` above is ignored to prevent, just landing under docs/ instead. Ignore
# only the `analysis/` subtree so each bundle's genuine handoff evidence (reports/,
# SUMMARY.md, environment.json, pytest_output.txt, cli_output.txt, calibration_*)
# is still committed. The `*` matches current AND future bundles, so a new handoff
# never re-bloats the repo. Already-tracked trees still need one-time untracking.
# Use an UNQUOTED shell glob so it expands to the real per-bundle dirs before git
# sees it: a quoted git pathspec '.../*/analysis' treats * as matching / and
# removes nothing (a silent no-op), and matching the wildcard against the whole
# tree is pathologically slow. --ignore-unmatch tolerates not-yet-committed
# bundles whose analysis/ is on disk but not in the index:
#   git rm -r --cached -q --ignore-unmatch docs/plans/handoff/bundles/*/analysis
docs/plans/handoff/bundles/*/analysis/

# Environment leakage in the repo root (noticed 2026-10-05). Nine dotfiles
# appeared here dated 2026-08-27, every one of them 0 bytes and read-only:
# .bashrc, .bash_profile, .profile, .zprofile, .zshrc, .gitconfig, .gitmodules,
# .mcp.json, .ripgreprc. That is the signature of a tool run with HOME pointed at
# the repo - the REAL files live in /home/ubuntu and are non-empty (a 6,232-byte
# .bashrc, a 807-byte .profile). .idea/ and .vscode/ were created empty by the
# same thing. None of it is project source, and all of it was
# untracked-but-unignored, so a stray `git add .` would have swept it in.
# Ignored rather than deleted: whatever created them can recreate them, and an
# ignore rule is what actually stops the commit.
# NOTE: if this project ever ships a real .mcp.json (MCP server config), drop
# that one line - it would then be project configuration, not leakage.
.bashrc
.bash_profile
.profile
.zprofile
.zshrc
.gitconfig
.gitmodules
.mcp.json
.ripgreprc
# .idea and .vscode are 0-byte read-only FILES here, not directories - the same
# placeholder signature, so no trailing slash (which would match only a dir).
.idea
.vscode
# Claude Code's workspace (.claude/agents, routines, workflows, settings) is local
# tooling, not project source - it is here only because that tool also ran with
# HOME pointed at the repo.
.claude/
# Run output, the same class as outputs/ above: regenerated by every run.
run_logs/

# paper/: the generated documents are build artifacts - build_ieee_docx.py and the
# other builders in there produce them FROM paper.md - so they are the same class
# as outputs/ above. The SOURCE is tracked: paper.md and the build scripts.
# Noticed 2026-10-05 that the whole directory was untracked, which left a
# final-year deliverable with no history at all.
paper/*.docx
paper/*.pptx
paper/__pycache__/

# AI-augmentation output location: generated per-target bypass candidates are
# run outputs (flagged for human review), not source. Tests must save_dir into a
# temp tree instead.
src/dynamic/scripts/ai_generated/
