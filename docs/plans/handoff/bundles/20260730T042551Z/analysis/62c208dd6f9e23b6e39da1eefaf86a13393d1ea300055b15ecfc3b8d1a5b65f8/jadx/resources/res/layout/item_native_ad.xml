<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nativeAdCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/global_root_stats_card_top_margin"
    card_view:cardUseCompatPadding="true"
    card_view:contentPaddingRight="20dp"
    card_view:contentPaddingTop="8dp">
    <com.google.android.gms.ads.nativead.NativeAdView
        android:id="@+id/native_ad_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/nativeAdsLeft"
                    android:paddingLeft="6dp"
                    android:paddingTop="8dp"
                    android:paddingRight="6dp"
                    android:paddingBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_gravity="center"
                        android:id="@+id/ad_badge"
                        android:paddingBottom="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nativeAdsAdMobAd"/>
                    <ImageView
                        android:layout_gravity="center"
                        android:id="@+id/ad_app_icon"
                        android:background="@null"
                        android:layout_width="60dp"
                        android:layout_height="60dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/nativeAdTextContent"
                    android:paddingLeft="8dp"
                    android:paddingTop="8dp"
                    android:paddingRight="8dp"
                    android:paddingBottom="6dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <TextView
                        android:textColor="?android:attr/textColorPrimaryInverse"
                        android:ellipsize="end"
                        android:id="@+id/ad_headline"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="20dp"
                        android:maxLines="2"/>
                    <TextView
                        android:textColor="?android:attr/textColorPrimaryInverse"
                        android:ellipsize="end"
                        android:id="@+id/ad_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="3"/>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:gravity="end|center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:ellipsize="end"
                    android:id="@+id/ad_advertiser"
                    android:paddingLeft="8dp"
                    android:paddingRight="8dp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="13sp"
                    android:ellipsize="end"
                    android:id="@+id/ad_call_to_action"
                    android:background="?attr/selectableItemBackground"
                    android:paddingLeft="10dp"
                    android:paddingTop="6dp"
                    android:paddingRight="10dp"
                    android:paddingBottom="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="8dp"
                    android:maxWidth="110dp"
                    android:minWidth="64dp"
                    android:maxLines="1"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.gms.ads.nativead.NativeAdView>
</androidx.cardview.widget.CardView>
