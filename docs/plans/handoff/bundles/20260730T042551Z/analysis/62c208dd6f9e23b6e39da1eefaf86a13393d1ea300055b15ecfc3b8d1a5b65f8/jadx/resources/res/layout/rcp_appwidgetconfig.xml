<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/appWidgetConfigScrollView"
    android:background="@color/windowBackground"
    android:layout_width="wrap_content"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:textColor="@color/textColorSecondaryInverse"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/timeIntervalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widgetTimeIntervalLabel"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/textColorSecondaryInverse"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/timeIntervalDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/widgetTimeIntervalDetails"/>
        <EditText
            android:textColor="@color/textColorSecondaryInverse"
            android:textColorHint="@color/textColorSecondaryInverse"
            android:layout_gravity="center"
            android:id="@+id/setTimeInterval"
            android:paddingTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLength="2"
            android:inputType="number"/>
        <LinearLayout
            android:layout_gravity="center"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <Button
                android:textColor="@color/textColorSecondaryInverse"
                android:id="@+id/btnOk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/universalBtnOkay"/>
            <TextView
                android:textSize="10sp"
                android:id="@+id/Spacer2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/spacer"/>
            <Button
                android:textColor="@color/textColorSecondaryInverse"
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/universalBtnCancel"/>
        </LinearLayout>
        <TextView
            android:textSize="12sp"
            android:textColor="@color/textColorSecondaryInverse"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/widgetUsageInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/widgetUsageInfo"/>
    </LinearLayout>
</ScrollView>
