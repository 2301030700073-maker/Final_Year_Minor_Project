<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="horizontal"
    android:id="@+id/full_widget"
    android:background="@drawable/widget_shape"
    android:padding="@dimen/widget_margin"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="180dp"
    android:minHeight="48dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="48dp">
    <ImageView
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/widImgLogo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/widget_icon"
        android:scaleType="fitXY"
        android:minWidth="48dp"
        android:minHeight="48dp"/>
    <RelativeLayout
        android:orientation="vertical"
        android:id="@+id/widTextViewLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_gravity="center"
            android:id="@+id/widgetLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/mainTitleRCP"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:layout_gravity="center"
            android:id="@+id/rootStatusResults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/widgetLabel"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:layout_gravity="center"
            android:id="@+id/busyboxStatusResults"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rootStatusResults"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</LinearLayout>
