<?xml version="1.0" encoding="utf-8"?>
<com.joeykrim.rootcheck.Views.CustomNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/moreRootToolsCustomNestedScrollView"
    android:background="@color/windowBackground"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/verifyRootlinLayout"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewPromoAppsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <RelativeLayout
                android:paddingLeft="16dp"
                android:paddingTop="10dp"
                android:paddingRight="16dp"
                android:paddingBottom="10dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/promoAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/nexTxtMoreToolsTitle"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewPromoBPE"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp">
            <RelativeLayout
                android:paddingLeft="16dp"
                android:paddingTop="5dp"
                android:paddingRight="16dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/iconBPE"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/icon_bpe"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/promoAppBPETitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/newTxtMoreToolsBPETitle"
                    android:layout_toRightOf="@+id/iconBPE"/>
                <TextView
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/promoAppBPEDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/newTxtMoreToolsBPEDetails"
                    android:layout_toRightOf="@+id/iconBPE"
                    android:layout_below="@+id/promoAppBPETitle"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewPromoRQL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp">
            <RelativeLayout
                android:paddingLeft="16dp"
                android:paddingTop="5dp"
                android:paddingRight="16dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/iconRQL"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/icon_rql"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/promoAppRQLTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/newTxtMoreToolsRQLTitle"
                    android:layout_toRightOf="@+id/iconRQL"/>
                <TextView
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/promoAppRQLDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/newTxtMoreToolsRQLDetails"
                    android:layout_toRightOf="@+id/iconRQL"
                    android:layout_below="@+id/promoAppRQLTitle"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewPromoFIG"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp">
            <RelativeLayout
                android:paddingLeft="16dp"
                android:paddingTop="5dp"
                android:paddingRight="16dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/iconFIG"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/icon_fig"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/promoAppFIGTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/newTxtMoreToolsFIGTitle"
                    android:layout_toRightOf="@+id/iconFIG"/>
                <TextView
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/promoAppFIGDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/newTxtMoreToolsFIGDetails"
                    android:layout_toRightOf="@+id/iconFIG"
                    android:layout_below="@+id/promoAppFIGTitle"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewCredits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp">
            <RelativeLayout
                android:paddingLeft="16dp"
                android:paddingTop="5dp"
                android:paddingRight="16dp"
                android:paddingBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/creditsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/creditsTitle"/>
                <TextView
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:textColorLink="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/creditsDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:text="@string/creditsDetails"
                    android:layout_below="@+id/creditsTitle"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</com.joeykrim.rootcheck.Views.CustomNestedScrollView>
