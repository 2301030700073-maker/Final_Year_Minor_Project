<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/currentDeviceSummaryCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/global_root_stats_card_top_margin"
    card_view:cardUseCompatPadding="true">
    <RelativeLayout
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <TextView
            android:id="@+id/currentDeviceMakeModelTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:bufferType="spannable"
            android:layout_centerHorizontal="true"/>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/currentDeviceMakeModelTitle">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/globalResultLinLayoutLeft"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginRight="12dp"
                android:layout_centerVertical="true">
                <ImageView
                    android:layout_gravity="center"
                    android:id="@+id/currentDeviceSummaryResultImage"
                    android:visibility="gone"
                    android:layout_width="60dp"
                    android:layout_height="60dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_toRightOf="@+id/globalResultLinLayoutLeft"
                android:layout_alignParentTop="true">
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/currentDeviceSummaryCountOfOS"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:bufferType="spannable"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/currentDeviceRootAvailableSummary"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:bufferType="spannable"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/currentDeviceSummaryMostPopularReasonInstallRoot"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:bufferType="spannable"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/currentDeviceLatestOSVersion"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:bufferType="spannable"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/currentDeviceLatestOSRootDifficulty"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:bufferType="spannable"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/currentDeviceLatestOSRootInstallRank"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:bufferType="spannable"/>
                <TextView
                    android:textSize="14sp"
                    android:id="@+id/currentDeviceManufInstallRootRank"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:bufferType="spannable"/>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
