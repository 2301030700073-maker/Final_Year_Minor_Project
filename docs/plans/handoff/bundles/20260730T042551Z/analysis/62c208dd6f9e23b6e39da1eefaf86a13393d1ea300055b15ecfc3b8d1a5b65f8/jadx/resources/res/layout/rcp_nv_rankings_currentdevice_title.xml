<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/globalResultsCurrentDeviceTitleCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardUseCompatPadding="true">
    <RelativeLayout
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimaryInverse"
            android:id="@+id/globalResultsCurrentDeviceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/globalResultCurrentDeviceTitle"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/globalResultCurrentDeviceDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/globalResultRootDeviceDescription"
            android:layout_below="@+id/globalResultsCurrentDeviceTitle"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
