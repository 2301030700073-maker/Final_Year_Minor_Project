<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardViewRootHorizontalStackBarChart"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/global_root_stats_card_top_margin"
    card_view:cardUseCompatPadding="true">
    <RelativeLayout
        android:id="@+id/overallRelLayRootGlobalChart"
        android:padding="6dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/overallRelLayRootGlobalChartTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="14sp"
                android:textColor="?android:attr/textColorPrimaryInverse"
                android:id="@+id/rootGlobalChartTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondaryInverse"
                android:id="@+id/rootGlobalChartTitleDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rootGlobalChartTitle"
                android:layout_centerHorizontal="true"/>
        </RelativeLayout>
        <View
            android:id="@+id/chartTitleDetailsSeparator"
            android:background="@color/grey300"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_below="@+id/overallRelLayRootGlobalChartTitle"/>
        <RelativeLayout
            android:gravity="center_horizontal"
            android:id="@+id/legendRelLayRootGlobalChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/chartTitleDetailsSeparator">
            <TextView
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondaryInverse"
                android:id="@+id/legendEasy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/globalResultRootDifficultyLevelLegendEasy"
                android:drawableLeft="@drawable/legend_stacked_easy"
                android:drawablePadding="4dp"/>
            <TextView
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondaryInverse"
                android:id="@+id/legendMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/globalResultRootDifficultyLevelLegendMedium"
                android:drawableLeft="@drawable/legend_stacked_medium"
                android:drawablePadding="4dp"
                android:layout_toRightOf="@+id/legendEasy"/>
            <TextView
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondaryInverse"
                android:id="@+id/legendHard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/globalResultRootDifficultyLevelLegendHard"
                android:drawableLeft="@drawable/legend_stacked_hard"
                android:drawablePadding="4dp"
                android:layout_toRightOf="@+id/legendMedium"/>
            <TextView
                android:textSize="12sp"
                android:textColor="?android:attr/textColorSecondaryInverse"
                android:id="@+id/legendExpert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:text="@string/globalResultRootDifficultyLevelLegendExpert"
                android:drawableLeft="@drawable/legend_stacked_expert"
                android:drawablePadding="4dp"
                android:layout_toRightOf="@+id/legendHard"/>
        </RelativeLayout>
        <com.db.chart.view.HorizontalStackBarChartView
            android:id="@+id/horizontalStackBarChartView"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_below="@+id/legendRelLayRootGlobalChart"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
