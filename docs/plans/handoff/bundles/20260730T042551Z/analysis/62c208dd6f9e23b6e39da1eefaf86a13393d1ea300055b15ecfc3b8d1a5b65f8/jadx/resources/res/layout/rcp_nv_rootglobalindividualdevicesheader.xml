<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardViewGlobalResultsIndividualDevicesHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/global_root_stats_card_top_margin"
    card_view:cardUseCompatPadding="true">
    <RelativeLayout
        android:padding="2dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimaryInverse"
            android:id="@+id/globalResultRootDeviceTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/globalResultRootDeviceTopBottomTitle"
            android:layout_centerHorizontal="true"/>
        <TextView
            android:textSize="12sp"
            android:id="@+id/globalResultsLastUpdated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/globalResultRootDeviceDescription"
            android:layout_below="@+id/globalResultRootDeviceTitle"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
