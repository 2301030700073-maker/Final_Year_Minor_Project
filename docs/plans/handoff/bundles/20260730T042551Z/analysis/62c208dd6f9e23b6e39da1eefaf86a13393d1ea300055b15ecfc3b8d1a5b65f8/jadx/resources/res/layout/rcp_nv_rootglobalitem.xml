<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootGlobalCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/global_root_stats_card_top_margin"
    card_view:cardUseCompatPadding="true">
    <RelativeLayout
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/globalResultLinLayoutLeft"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginRight="12dp"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="16sp"
                android:layout_gravity="center"
                android:id="@+id/globalResultRank"
                android:paddingBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:bufferType="spannable"
                android:layout_alignParentTop="true"/>
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/globalResultImage"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_below="@+id/globalResultRank"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_toRightOf="@+id/globalResultLinLayoutLeft"
            android:layout_centerVertical="true">
            <TextView
                android:textSize="14sp"
                android:id="@+id/globalResultDeviceMakeModel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:bufferType="spannable"/>
            <TextView
                android:textSize="14sp"
                android:id="@+id/globalResultOSVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:bufferType="spannable"/>
            <TextView
                android:textSize="14sp"
                android:id="@+id/globalResultRootStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:bufferType="spannable"/>
            <TextView
                android:textSize="14sp"
                android:id="@+id/globalResultRootDifficulty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:bufferType="spannable"/>
            <TextView
                android:textSize="14sp"
                android:id="@+id/globalResultMostPopularReasonInstallRoot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:bufferType="spannable"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>
