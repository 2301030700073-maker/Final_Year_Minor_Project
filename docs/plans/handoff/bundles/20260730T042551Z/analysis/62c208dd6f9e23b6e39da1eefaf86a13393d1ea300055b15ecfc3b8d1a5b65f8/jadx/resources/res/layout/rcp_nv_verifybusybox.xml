<?xml version="1.0" encoding="utf-8"?>
<com.joeykrim.rootcheck.Views.CustomNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:scrollbarSize="3dp"
    android:scrollbarThumbVertical="@color/grey400"
    android:id="@+id/verifyBusyBoxCustomNestedScrollView"
    android:background="@color/windowBackground"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/verifyBusyBoxlinLayout"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewVerifyBusyBox"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:minHeight="150dp"
            card_view:cardUseCompatPadding="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/relativeVerifyBusyBox"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <ImageView
                        android:id="@+id/imgViewResultIcon"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/busybox_status_gray"/>
                    <TextView
                        android:textSize="18sp"
                        android:id="@+id/txtBusyBoxResults"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_toRightOf="@+id/imgViewResultIcon"/>
                </RelativeLayout>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/colorTextCTA"
                    android:layout_gravity="bottom|right"
                    android:id="@+id/txtVerifyBusyBox"
                    android:paddingRight="16dp"
                    android:paddingBottom="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/verifyBusyBoxCAPS"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewSysEnvPathStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            card_view:cardUseCompatPadding="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/sysEnvPathStatusTitle"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="@string/sysEnvPathStatusTitleVB"/>
                <View
                    android:id="@+id/stageAdditionalSeparator"
                    android:background="@color/grey200"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/sysEnvPathStatusTitle"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/sysEnvPathStatusDetails"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_below="@+id/stageAdditionalSeparator"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewBinaryLocationStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            card_view:cardUseCompatPadding="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/binaryLocationTitle"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="@string/binaryLocationTitle"/>
                <View
                    android:id="@+id/binaryLocationTitleSeparator"
                    android:background="@color/grey200"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/binaryLocationTitle"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/binaryLocationDetails"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_below="@+id/binaryLocationTitleSeparator"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewBinaryInfoStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            card_view:cardUseCompatPadding="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/binaryInfoStatusTitle"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="@string/binaryInfoStatusTitle"/>
                <View
                    android:id="@+id/binaryInfoStatusTitleSeparator"
                    android:background="@color/grey200"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/binaryInfoStatusTitle"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/binaryInfoStatusDetails"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:bufferType="spannable"
                    android:layout_below="@+id/binaryInfoStatusTitleSeparator"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewBinaryVersionStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            card_view:cardUseCompatPadding="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/binaryVersionStatusTitle"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="@string/binaryVersionStatusTitle"/>
                <View
                    android:id="@+id/binaryVersionStatusTitleSeparator"
                    android:background="@color/grey200"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/binaryVersionStatusTitle"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/binaryVersionStatusDetails"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_below="@+id/binaryVersionStatusTitleSeparator"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewBusyBoxAppletsStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            card_view:cardUseCompatPadding="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/busyBoxAppletsStatusTitle"
                    android:padding="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="@string/busyBoxAppletsStatusTitle"/>
                <View
                    android:id="@+id/busyBoxAppletsStatusTitleSeparator"
                    android:background="@color/grey200"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/busyBoxAppletsStatusTitle"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/busyBoxAppletsStatusDetails"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:layout_below="@+id/busyBoxAppletsStatusTitleSeparator"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</com.joeykrim.rootcheck.Views.CustomNestedScrollView>
