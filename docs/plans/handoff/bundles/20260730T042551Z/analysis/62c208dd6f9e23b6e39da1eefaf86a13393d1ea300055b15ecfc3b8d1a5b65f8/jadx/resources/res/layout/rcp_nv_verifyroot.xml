<?xml version="1.0" encoding="utf-8"?>
<com.joeykrim.rootcheck.Views.CustomNestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:scrollbarSize="3dp"
    android:scrollbarThumbVertical="@color/grey400"
    android:id="@+id/verifyRootProCustomNestedScrollView"
    android:background="@color/windowBackground"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/verifyRootProLinLayout"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:animateLayoutChanges="true">
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewVerifyRoot"
            android:background="@color/transparent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:minHeight="150dp"
            card_view:cardUseCompatPadding="true">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <RelativeLayout
                    android:id="@+id/relativeVerifyRoot"
                    android:padding="16dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:id="@+id/relativeViewResultIcon"
                        android:layout_width="88dp"
                        android:layout_height="88dp">
                        <ImageView
                            android:id="@+id/imgViewResultIcon"
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:src="@drawable/root_status_gray"
                            android:layout_centerInParent="true"/>
                        <com.joeykrim.rootcheck.Views.ProgressWheelv2
                            android:id="@+id/pwSpinnerv2"
                            android:layout_width="88dp"
                            android:layout_height="88dp"
                            android:layout_centerInParent="true"/>
                    </RelativeLayout>
                    <TextView
                        android:textSize="18sp"
                        android:id="@+id/txtRootResults"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_toRightOf="@+id/relativeViewResultIcon"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorSecondaryInverse"
                        android:id="@+id/txtCurrentDevice"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="16dp"
                        android:layout_toRightOf="@+id/relativeViewResultIcon"
                        android:layout_below="@+id/txtRootResults"/>
                </RelativeLayout>
                <TextView
                    android:textStyle="bold"
                    android:textColor="@color/colorTextCTA"
                    android:layout_gravity="bottom|right"
                    android:id="@+id/txtVerifyRoot"
                    android:paddingRight="16dp"
                    android:paddingBottom="16dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/verifyRootCAPS"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewRecommend"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            card_view:cardUseCompatPadding="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/overflowRecommend"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_action_overflow_dark"
                    android:layout_alignParentRight="true"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/recommendTitle"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/recommendTitle"/>
                <View
                    android:id="@+id/recommendTitleSeparator"
                    android:background="@color/grey300"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/recommendTitle"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/recommendDetails"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_below="@+id/recommendTitleSeparator"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewSUAppStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            card_view:cardUseCompatPadding="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/feedbackSUAppStatus"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_action_overflow_dark"
                    android:layout_alignParentRight="true"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/SUAppStatusTitle"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/SUAppStatusTitle"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/SUAppStatusDetailsLinLayout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/SUAppStatusTitle">
                    <View
                        android:id="@+id/SUAppStatusTitleSeparator"
                        android:background="@color/grey300"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorSecondaryInverse"
                        android:id="@+id/SUAppStatusDetails"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"/>
                </LinearLayout>
                <View
                    android:id="@+id/SUAppStatusNavigationSeparator"
                    android:background="@color/grey300"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/SUAppStatusDetailsLinLayout"/>
                <ImageView
                    android:id="@+id/SUAppStatusNavigationImg"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/btn_action_expand"
                    android:scaleType="fitCenter"
                    android:layout_below="@+id/SUAppStatusNavigationSeparator"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/SUAppStatusNavigationText"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="@string/navigationShowDetails"
                    android:layout_toRightOf="@+id/SUAppStatusNavigationImg"
                    android:layout_below="@+id/SUAppStatusNavigationSeparator"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewSystemFilesStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            card_view:cardUseCompatPadding="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/feedbackSystemFilesStatus"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_action_overflow_dark"
                    android:layout_alignParentRight="true"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/systemFilesStatusTitle"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/systemFilesStatusTitlev2"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/systemFilesStatusDetailsLinLayout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/systemFilesStatusTitle">
                    <View
                        android:id="@+id/systemFilesStatusTitleSeparator"
                        android:background="@color/grey300"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorSecondaryInverse"
                        android:id="@+id/systemFilesStatusDetails"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:bufferType="spannable"/>
                </LinearLayout>
                <View
                    android:id="@+id/systemFilesStatusNavigationSeparator"
                    android:background="@color/grey300"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/systemFilesStatusDetailsLinLayout"/>
                <ImageView
                    android:id="@+id/systemFileStatusNavigationImg"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/btn_action_expand"
                    android:scaleType="fitCenter"
                    android:layout_below="@+id/systemFilesStatusNavigationSeparator"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/systemFileStatusNavigationText"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="@string/navigationShowDetails"
                    android:layout_toRightOf="@+id/systemFileStatusNavigationImg"
                    android:layout_below="@+id/systemFilesStatusNavigationSeparator"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewIDStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            card_view:cardUseCompatPadding="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/feedbackIDStatus"
                    android:visibility="gone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_action_overflow_dark"
                    android:layout_alignParentRight="true"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/idStatusTitle"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/idStatusTitle"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/idStatusDetailsLinLayout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_below="@+id/idStatusTitle">
                    <View
                        android:id="@+id/idStatusTitleSeparator"
                        android:background="@color/grey300"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorSecondaryInverse"
                        android:id="@+id/idStatusDetails"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:bufferType="spannable"/>
                </LinearLayout>
                <View
                    android:id="@+id/idStatusNavigationSeparator"
                    android:background="@color/grey300"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/idStatusDetailsLinLayout"/>
                <ImageView
                    android:id="@+id/idStatusNavigationImg"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/btn_action_expand"
                    android:scaleType="fitCenter"
                    android:layout_below="@+id/idStatusNavigationSeparator"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/idStatusNavigationText"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="@string/navigationShowDetails"
                    android:layout_toRightOf="@+id/idStatusNavigationImg"
                    android:layout_below="@+id/idStatusNavigationSeparator"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewADBShellUserStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            card_view:cardUseCompatPadding="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/ADBShellUserStatusTitle"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/ADBShellUserStatusTitle"/>
                <View
                    android:id="@+id/ADBShellUserStatusTitleSeparator"
                    android:background="@color/grey300"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/ADBShellUserStatusTitle"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/ADBShellUserStatusDetails"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_below="@+id/ADBShellUserStatusTitleSeparator"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewPlayIntegrityStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            card_view:cardUseCompatPadding="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/playIntegrityStatusTitle"
                    android:padding="6dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="4dp"
                    android:text="@string/playIntegrityStatusTitle"
                    android:layout_alignParentLeft="true"/>
                <LinearLayout
                    android:orientation="vertical"
                    android:id="@+id/playIntegrityStatusHelpLinLayout"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/playIntegrityStatusTitle">
                    <View
                        android:background="@color/grey300"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <TextView
                        android:textSize="14sp"
                        android:textColor="?android:attr/textColorSecondaryInverse"
                        android:id="@+id/playIntegrityStatusDetails"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginRight="12dp"/>
                    <View
                        android:background="@color/grey300"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <TextView
                        android:textSize="12sp"
                        android:textColor="?android:attr/textColorSecondaryInverse"
                        android:id="@+id/playIntegrityStatusHelpText"
                        android:padding="8dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:layout_marginRight="12dp"
                        android:text="@string/playIntegrityHelpText"/>
                </LinearLayout>
                <View
                    android:id="@+id/playIntegrityStatusNavigationSeparator"
                    android:background="@color/grey300"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/playIntegrityStatusHelpLinLayout"/>
                <ImageView
                    android:id="@+id/playIntegrityStatusNavigationImg"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/btn_action_expand"
                    android:scaleType="fitCenter"
                    android:layout_below="@+id/playIntegrityStatusNavigationSeparator"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/playIntegrityStatusNavigationText"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="@string/navigationShowDetails"
                    android:layout_toRightOf="@+id/playIntegrityStatusNavigationImg"
                    android:layout_below="@+id/playIntegrityStatusNavigationSeparator"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewSELinuxStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            card_view:cardUseCompatPadding="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/SELinuxStatusTitle"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/SELinuxStatusTitle"/>
                <View
                    android:id="@+id/SELinuxStatusTitleSeparator"
                    android:background="@color/grey300"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/SELinuxStatusTitle"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/SELinuxStatusDetails"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_below="@+id/SELinuxStatusTitleSeparator"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
        <androidx.cardview.widget.CardView
            android:layout_gravity="center"
            android:id="@+id/cardViewSysEnvPathStatus"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            card_view:cardUseCompatPadding="true">
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorPrimaryInverse"
                    android:id="@+id/sysEnvPathStatusTitle"
                    android:padding="6dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="4dp"
                    android:layout_marginRight="20dp"
                    android:text="@string/sysEnvPathStatusTitleVR"/>
                <View
                    android:id="@+id/sysEnvPathStatusTitleSeparator"
                    android:background="@color/grey300"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_below="@+id/sysEnvPathStatusTitle"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?android:attr/textColorSecondaryInverse"
                    android:id="@+id/sysEnvPathStatusDetails"
                    android:padding="8dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_below="@+id/sysEnvPathStatusTitleSeparator"/>
            </RelativeLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</com.joeykrim.rootcheck.Views.CustomNestedScrollView>
