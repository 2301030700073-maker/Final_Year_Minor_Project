<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/dialog_linear_layout"
        android:background="@color/transparent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="20sp"
            android:textStyle="bold"
            android:id="@+id/dialog_md_title"
            android:paddingLeft="24dp"
            android:paddingTop="24dp"
            android:paddingRight="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/vrSurveyRootMethodDescription"/>
        <RadioGroup
            android:paddingLeft="24dp"
            android:paddingTop="24dp"
            android:paddingRight="24dp"
            android:paddingBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton
                android:textSize="14sp"
                android:textColor="@color/textColor"
                android:id="@+id/vrSurveyRootMethodOption1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vrSurveyRootMethodOptionOEM"/>
            <RadioButton
                android:textSize="14sp"
                android:textColor="@color/textColor"
                android:id="@+id/vrSurveyRootMethodOption2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vrSurveyRootMethodOptionKingRoot"/>
            <RadioButton
                android:textSize="14sp"
                android:textColor="@color/textColor"
                android:id="@+id/vrSurveyRootMethodOption3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vrSurveyRootMethodOptionKingoRoot"/>
            <RadioButton
                android:textSize="14sp"
                android:textColor="@color/textColor"
                android:id="@+id/vrSurveyRootMethodOption4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vrSurveyRootMethodOptionTowelRoot"/>
            <RadioButton
                android:textSize="14sp"
                android:textColor="@color/textColor"
                android:id="@+id/vrSurveyRootMethodOption5"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vrSurveyRootMethodOptionOdin"/>
            <RadioButton
                android:textSize="14sp"
                android:textColor="@color/textColor"
                android:id="@+id/vrSurveyRootMethodOption6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vrSurveyRootMethodOptioniRoot"/>
            <RadioButton
                android:textSize="14sp"
                android:textColor="@color/textColor"
                android:id="@+id/vrSurveyRootMethodOption7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vrSurveyRootMethodOptionFramaroot"/>
            <RadioButton
                android:textSize="14sp"
                android:textColor="@color/textColor"
                android:id="@+id/vrSurveyRootMethodOptionOther"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vrSurveyRootMethodOptionOther"/>
            <LinearLayout
                android:id="@+id/vrSurveyRootMethodOtherLinLayout"
                android:paddingLeft="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <EditText
                    android:textSize="14sp"
                    android:textColor="@color/textColor"
                    android:id="@+id/vrSurveyRootMethodOptionOtherDetails"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="@string/vrSurveyRootMethodOptionOtherHint"
                    android:singleLine="true"
                    android:maxLength="100"
                    android:inputType="textAutoCorrect"
                    android:textIsSelectable="true"/>
            </LinearLayout>
        </RadioGroup>
        <RelativeLayout
            android:id="@+id/dialog_md_alongside_buttons"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="16dp"
            android:layout_marginRight="16dp">
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:id="@+id/dialog_md_confirm"
                android:background="@drawable/button_selector"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/universalBtnSubmit"
                android:layout_alignParentRight="true"/>
            <Button
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/grey400"
                android:id="@+id/dialog_md_cancel"
                android:background="@drawable/button_selector"
                android:padding="8dp"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/universalBtnCancel"
                android:layout_toLeftOf="@+id/dialog_md_confirm"/>
        </RelativeLayout>
    </LinearLayout>
</ScrollView>
