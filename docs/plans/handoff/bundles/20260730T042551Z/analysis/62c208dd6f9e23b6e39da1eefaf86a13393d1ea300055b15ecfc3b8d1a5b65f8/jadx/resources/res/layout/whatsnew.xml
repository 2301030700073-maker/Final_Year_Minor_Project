<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:padding="10dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rlTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/whatsNewRootIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentRight="true"
            android:layout_centerHorizontal="true"
            android:contentDescription="@string/whatsNewIconDescription"/>
        <TextView
            android:textSize="22sp"
            android:gravity="center"
            android:id="@+id/whatsNewTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:layout_toLeftOf="@+id/whatsNewRootIcon"/>
    </RelativeLayout>
    <ScrollView
        android:id="@+id/whatsNewScrollView"
        android:paddingBottom="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rlTitle">
        <TextView
            android:textSize="18sp"
            android:id="@+id/tvWhatsNew"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@+id/whatsNew"/>
    </ScrollView>
    <LinearLayout
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingTop="5dp"
        android:paddingRight="4dp"
        android:paddingBottom="1dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/whatsNewScrollView">
        <Button
            android:id="@+id/followOnTwitter"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/universalBtnFollowTwitter"
            android:layout_weight="1"/>
        <Button
            android:id="@+id/whatsNewBtnOkay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/universalBtnOkay"
            android:layout_weight="1"/>
    </LinearLayout>
</RelativeLayout>
