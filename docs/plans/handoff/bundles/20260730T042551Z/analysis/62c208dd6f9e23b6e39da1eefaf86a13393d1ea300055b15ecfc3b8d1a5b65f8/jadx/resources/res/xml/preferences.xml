<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" android:key="@string/preferenceScreenKey">
    <PreferenceCategory
        android:title="@string/prefCategoryTitleNotifications"
        android:key="@string/prefCategoryTitleNotificationsKey">
        <CheckBoxPreference
            android:title="@string/prefCBTitleNotificationsPromo"
            android:key="@string/prefCBKeyNotificationsPromo"
            android:summary="@string/prefCBSummaryNotificationsPromo"
            android:defaultValue="true"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/prefCategoryTitleTheme"
        android:key="@string/prefCategoryTitleThemeKey">
        <CheckBoxPreference
            android:title="@string/prefCBTitleDarkTheme"
            android:key="@string/prefCBKeyDarkThemePaid"
            android:summary="@string/prefCBSummaryDarkThemePaid"
            android:defaultValue="false"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/prefCategoryTitleFeedback"
        android:key="@string/prefCategoryTitleFeedbackKey">
        <Preference
            android:title="@string/prefTitleReqFeature"
            android:key="@string/prefKeyReqFeature"
            android:summary="@string/prefSummaryReqFeature"/>
        <Preference
            android:title="@string/reportIssueTitle"
            android:key="@string/prefKeyReportIssue"
            android:summary="@string/prefSummaryReportIssue"/>
        <Preference
            android:title="@string/prefTitleFollowTwitter"
            android:key="@string/prefKeyFollowTwitter"
            android:summary="@string/prefSummaryFollowTwitter"/>
    </PreferenceCategory>
    <PreferenceCategory
        android:title="@string/prefCategoryTitleAbout"
        android:key="@string/prefCategoryTitleAboutKey">
        <Preference
            android:title="@string/prefTitleVersion"
            android:key="@string/prefKeyAboutVersion"/>
        <Preference
            android:title="@string/prefTitleWhatsNew"
            android:key="@string/prefKeyWhatsNew"
            android:summary="@string/prefSummaryWhatsNew"/>
        <Preference
            android:title="@string/prefTitleWelcomeScreens"
            android:key="@string/prefKeyWelcomeScreens"
            android:summary="@string/prefSummaryWelcomeScreens"/>
        <Preference
            android:title="@string/prefTitleAcknowledgement"
            android:key="@string/prefKeyAcknowledgement"
            android:summary="@string/prefSummaryAcknowledgement"/>
        <Preference
            android:title="@string/menuDisclaimer"
            android:key="@string/prefKeyAboutDisclaimer"
            android:summary="@string/prefSummaryDisclaimer"/>
        <Preference
            android:title="@string/prefTitlePrivacyPolicy"
            android:key="@string/prefKeyPrivacyPolicy"
            android:summary="@string/prefSummaryPrivacyPolicy"/>
        <Preference
            android:title="@string/prefTitlePrivacyConsent"
            android:key="@string/prefKeyPrivacyConsent"
            android:summary="@string/prefSummaryPrivacyConsent"/>
    </PreferenceCategory>
</PreferenceScreen>
