<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.nexuslauncher.overview.NexusOverviewActionsView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="bottom|center_horizontal"
    android:layout_width="match_parent"
    android:layout_height="@dimen/overview_actions_height"
    android:layout_marginLeft="@dimen/overview_actions_horizontal_margin"
    android:layout_marginRight="@dimen/overview_actions_horizontal_margin">
    <LinearLayout
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:id="@+id/action_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <Space
            android:layout_width="24dp"
            android:layout_height="1dp"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:theme="@style/ThemeControlHighlightWorkspaceColor"
                android:layout_gravity="center"
                android:id="@+id/action_screenshot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_screenshot"
                android:drawableStart="@drawable/ic_screenshot"
                style="@style/OverviewActionButton"/>
        </FrameLayout>
        <Space
            android:layout_width="8dp"
            android:layout_height="1dp"/>
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">
            <Button
                android:theme="@style/ThemeControlHighlightWorkspaceColor"
                android:layout_gravity="center"
                android:id="@+id/action_select"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_select"
                android:drawableStart="@drawable/ic_select"
                style="@style/OverviewActionButton"/>
        </FrameLayout>
        <Space
            android:layout_width="24dp"
            android:layout_height="1dp"/>
        <Button
            android:theme="@style/ThemeControlHighlightWorkspaceColor"
            android:id="@+id/action_share"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_share"
            android:drawableStart="@drawable/ic_share"
            style="@style/OverviewActionButton"/>
        <Space
            android:id="@+id/share_space"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="1dp"/>
    </LinearLayout>
    <FrameLayout
        android:layout_gravity="center"
        android:id="@+id/select_mode_buttons"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageButton
            android:theme="@style/ThemeControlHighlightWorkspaceColor"
            android:layout_gravity="center"
            android:id="@+id/close"
            android:background="@drawable/circle_btn_bg"
            android:layout_width="@dimen/select_mode_close_button_size"
            android:layout_height="@dimen/select_mode_close_button_size"
            android:src="@drawable/ic_close"
            android:contentDescription="@string/close"
            style="@style/OverviewActionButton"/>
        <Button
            android:theme="@style/ThemeControlHighlightWorkspaceColor"
            android:layout_gravity="start|center_vertical"
            android:id="@+id/feedback"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/feedback"
            style="@style/OverviewActionButton"/>
    </FrameLayout>
</com.google.android.apps.nexuslauncher.overview.NexusOverviewActionsView>
