<?xml version="1.0" encoding="utf-8"?>
<com.google.android.apps.nexuslauncher.qsb.AllAppsQsbLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="top|center_horizontal"
    android:id="@+id/search_container_all_apps"
    android:layout_width="match_parent"
    android:layout_height="@dimen/qsb_widget_height"
    android:layout_centerHorizontal="true"
    android:contentDescription="@string/label_search">
    <ImageView
        android:layout_gravity="start|center_vertical"
        android:id="@+id/g_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_super_g_color"/>
    <com.google.android.apps.nexuslauncher.qsb.AssistantIconView
        android:layout_gravity="end|center_vertical"
        android:id="@+id/mic_icon"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:focusable="false"
        android:clickable="true"
        android:layout_width="@dimen/qsb_mic_width"
        android:layout_height="match_parent"
        android:layout_marginTop="-6dp"
        android:layout_marginBottom="-6dp"
        android:contentDescription="@string/label_voice_search"/>
    <include layout="@layout/qsb_hint"/>
</com.google.android.apps.nexuslauncher.qsb.AllAppsQsbLayout>
