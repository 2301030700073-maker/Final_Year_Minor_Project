<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@+id/smartspace_content"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:paddingStart="@dimen/smartspace_padding_start_end_2x2"
    android:paddingEnd="@dimen/smartspace_padding_start_end_2x2">
    <com.google.android.apps.nexuslauncher.graphics.IcuDateTextView
        android:textSize="@dimen/smartspace_title_size_2x2"
        android:id="@+id/clock"
        android:background="@drawable/bg_smartspace"
        android:paddingLeft="10dp"
        android:paddingRight="10dp"
        android:visibility="visible"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="2"
        style="@style/SmartspaceTextHeadline"/>
    <com.google.android.apps.nexuslauncher.graphics.DoubleShadowTextView
        android:textSize="@dimen/smartspace_subtitle_weather_size_2x2"
        android:id="@+id/subtitle_weather_text"
        android:background="@drawable/bg_smartspace"
        android:paddingTop="2dp"
        android:paddingBottom="2dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        launcher:leadIconMargin="4dp"
        launcher:leadIconSize="@dimen/smartspace_weather_icon_size_2x2"
        style="@style/SmartspaceTextTitle"/>
</LinearLayout>
