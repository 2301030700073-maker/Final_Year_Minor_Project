<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:launcher="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:orientation="horizontal"
    android:id="@+id/smartspace_content"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true">
    <com.google.android.apps.nexuslauncher.graphics.IcuDateTextView
        android:textSize="@dimen/smartspace_title_size_5x5"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/clock"
        android:background="@drawable/bg_smartspace"
        android:paddingLeft="10dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:maxLines="1"
        android:layout_weight="1"
        style="@style/SmartspaceTextHeadline"/>
    <com.google.android.apps.nexuslauncher.graphics.DoubleShadowTextView
        android:textSize="@dimen/smartspace_title_size_5x5"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/title_weather_text"
        android:background="@drawable/bg_smartspace"
        android:paddingRight="10dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="0"
        launcher:leadIconMargin="4dp"
        launcher:leadIconSize="@dimen/smartspace_title_icon_size_5x5"
        style="@style/SmartspaceTextHeadline"/>
</LinearLayout>
