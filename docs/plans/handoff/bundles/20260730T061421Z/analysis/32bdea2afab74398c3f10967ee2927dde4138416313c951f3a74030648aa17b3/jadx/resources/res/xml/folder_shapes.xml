    <Circle
        launcher:folderIconRadius="1"
        launcher:searchIconClickFeedback="@drawable/search_icon_click_feedback_circle"/>
    <RoundedSquare
        launcher:folderIconRadius="0.24"
        launcher:qsbEdgeRadius="8dp"
        launcher:searchIconClickFeedback="@drawable/search_icon_click_feedback_roundrect"/>
