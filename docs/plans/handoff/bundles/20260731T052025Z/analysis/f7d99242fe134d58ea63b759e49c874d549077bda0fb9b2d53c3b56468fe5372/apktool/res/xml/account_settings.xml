<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/account_settings_title_fmt" android:key="main"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <Preference android:icon="@drawable/ic_settings" android:title="@string/account_settings_general_title" android:key="general" />
    <Preference android:icon="@drawable/ic_mark_email_read" android:title="@string/account_settings_reading_mail" android:key="reading_mail" />
    <Preference android:icon="@drawable/ic_sync" android:title="@string/account_settings_sync" android:key="fetching_mail" />
    <PreferenceScreen android:icon="@drawable/ic_edit" android:title="@string/account_settings_composition" android:key="composing">
        <Preference android:title="@string/account_settings_composition_label" android:key="composition" android:summary="@string/account_settings_composition_summary" />
        <Preference android:title="@string/account_settings_identities_label" android:key="manage_identities" android:summary="@string/account_settings_identities_summary" />
        <ListPreference android:entries="@array/message_format_entries" android:title="@string/account_settings_message_format_label" android:key="message_format" android:entryValues="@array/message_format_values" app:useSimpleSummaryProvider="true" />
        <CheckBoxPreference android:title="@string/account_settings_always_show_cc_bcc_label" android:key="always_show_cc_bcc" />
        <CheckBoxPreference android:title="@string/account_settings_message_read_receipt_label" android:key="message_read_receipt" android:summary="@string/account_settings_message_read_receipt_summary" />
        <ListPreference android:entries="@array/quote_style_entries" android:title="@string/account_settings_quote_style_label" android:key="quote_style" android:entryValues="@array/quote_style_values" app:useSimpleSummaryProvider="true" />
        <CheckBoxPreference android:title="@string/account_settings_default_quoted_text_shown_label" android:key="default_quoted_text_shown" android:summary="@string/account_settings_default_quoted_text_shown_summary" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/account_settings_reply_after_quote_label" android:key="reply_after_quote" android:summary="@string/account_settings_reply_after_quote_summary" android:dependency="quote_style" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/account_settings_strip_signature_label" android:key="strip_signature" android:summary="@string/account_settings_strip_signature_summary" android:defaultValue="true" />
        <com.takisoft.preferencex.AutoSummaryEditTextPreference android:title="@string/account_settings_quote_prefix_label" android:key="account_quote_prefix" android:dependency="quote_style" android:dialogTitle="@string/account_settings_quote_prefix_label" />
        <CheckBoxPreference android:title="@string/account_settings_upload_sent_messages_label" android:key="upload_sent_messages" android:summary="@string/account_settings_upload_sent_messages_summary" android:defaultValue="true" />
        <PreferenceScreen android:title="@string/account_settings_outgoing_label" android:key="outgoing" android:summary="@string/account_settings_outgoing_summary" />
    </PreferenceScreen>
    <PreferenceScreen android:icon="@drawable/ic_folder" android:title="@string/account_settings_folders" android:key="folders">
        <com.fsck.k9.ui.settings.account.FolderListPreference android:title="@string/account_setup_auto_select_folder" android:key="auto_select_folder" app:useSimpleSummaryProvider="true" />
        <CheckBoxPreference android:title="@string/account_setup_incoming_subscribed_folders_only_label" android:key="subscribed_folders_only" />
        <com.fsck.k9.ui.settings.account.FolderListPreference android:title="@string/archive_folder_label" android:key="archive_folder" app:useSimpleSummaryProvider="true" />
        <com.fsck.k9.ui.settings.account.FolderListPreference android:title="@string/drafts_folder_label" android:key="drafts_folder" app:useSimpleSummaryProvider="true" />
        <com.fsck.k9.ui.settings.account.FolderListPreference android:title="@string/sent_folder_label" android:key="sent_folder" app:useSimpleSummaryProvider="true" />
        <com.fsck.k9.ui.settings.account.FolderListPreference android:title="@string/spam_folder_label" android:key="spam_folder" app:useSimpleSummaryProvider="true" />
        <com.fsck.k9.ui.settings.account.FolderListPreference android:title="@string/trash_folder_label" android:key="trash_folder" app:useSimpleSummaryProvider="true" />
    </PreferenceScreen>
    <PreferenceScreen android:icon="@drawable/ic_notifications" android:title="@string/notifications_title" android:key="notifications">
        <CheckBoxPreference android:title="@string/account_settings_notify_label" android:key="account_notify" android:summary="@string/account_settings_notify_summary" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/account_settings_notify_self_label" android:key="account_notify_self" android:summary="@string/account_settings_notify_self_summary" android:dependency="account_notify" android:defaultValue="true" />
        <CheckBoxPreference android:title="@string/account_notify_contacts_mail_only_label" android:key="account_notify_contacts_mail_only" android:summary="@string/account_notify_contacts_mail_only_summary" android:dependency="account_notify" android:defaultValue="false" />
        <CheckBoxPreference android:title="@string/account_settings_ignore_chat_messages_label" android:key="ignore_chat_messages" android:summary="@string/account_settings_ignore_chat_messages_summary" android:dependency="account_notify" android:defaultValue="false" />
        <com.fsck.k9.ui.settings.account.NotificationSoundPreference android:title="@string/account_settings_ringtone" android:key="account_ringtone" android:dependency="account_notify" android:defaultValue="content://settings/system/notification_sound" />
        <com.fsck.k9.ui.settings.account.VibrationPreference android:entries="@array/vibrate_pattern_entries" android:title="@string/account_settings_vibration" android:key="account_combined_vibration" android:dependency="account_notify" android:entryValues="@array/vibrate_pattern_values" />
        <ListPreference android:entries="@array/notification_light_entries" android:title="@string/account_settings_notification_light_label" android:key="notification_light" android:dependency="account_notify" android:entryValues="@array/notification_light_values" app:useSimpleSummaryProvider="true" />
        <CheckBoxPreference android:title="@string/account_settings_notify_sync_label" android:key="account_notify_sync" android:summary="@string/account_settings_notify_sync_summary" android:defaultValue="true" />
        <PreferenceCategory android:title="@string/account_settings_notification_channels_label" android:key="notification_channels">
            <com.fsck.k9.ui.settings.account.NotificationsPreference android:title="@string/notification_channel_messages_title" android:key="open_notification_settings_messages" android:summary="@string/account_settings_open_notification_settings_messages_summary" />
            <com.fsck.k9.ui.settings.account.NotificationsPreference android:title="@string/notification_channel_miscellaneous_title" android:key="open_notification_settings_miscellaneous" android:summary="@string/account_settings_open_notification_settings_miscellaneous_summary" />
        </PreferenceCategory>
    </PreferenceScreen>
    <Preference android:icon="@drawable/ic_search" android:title="@string/account_settings_search" android:key="search" />
    <PreferenceScreen android:icon="@drawable/ic_lock" android:title="@string/account_settings_crypto" android:key="openpgp">
        <SwitchPreference android:title="@string/account_settings_crypto_app" android:key="openpgp_provider" />
        <org.openintents.openpgp.util.OpenPgpKeyPreference android:title="@string/account_settings_crypto_key" android:key="openpgp_key" android:dependency="openpgp_provider" />
        <com.fsck.k9.ui.settings.account.AutocryptPreferEncryptPreference android:title="@string/account_settings_crypto_prefer_encrypt" android:key="autocrypt_prefer_encrypt" android:dependency="openpgp_key" app:summaryOff="@string/switch_off" app:summaryOn="@string/switch_on" />
        <SwitchPreference android:title="@string/account_settings_crypto_hide_sign_only" android:key="openpgp_hide_sign_only" android:dependency="openpgp_key" android:summaryOn="@string/account_settings_crypto_hide_sign_only_on" android:summaryOff="@string/account_settings_crypto_hide_sign_only_off" />
        <SwitchPreference android:title="@string/account_settings_crypto_encrypt_subject" android:key="openpgp_encrypt_subject" android:summary="@string/account_settings_crypto_encrypt_subject_subtitle" android:dependency="openpgp_key" />
        <SwitchPreference android:title="@string/account_settings_crypto_encrypt_all_drafts" android:key="openpgp_encrypt_all_drafts" android:dependency="openpgp_key" android:summaryOn="@string/account_settings_crypto_encrypt_all_drafts_on" android:summaryOff="@string/account_settings_crypto_encrypt_all_drafts_off" />
        <Preference android:title="@string/ac_transfer_setting_title" android:key="autocrypt_transfer" android:summary="@string/ac_transfer_setting_summary" android:dependency="openpgp_key" />
    </PreferenceScreen>
</PreferenceScreen>
