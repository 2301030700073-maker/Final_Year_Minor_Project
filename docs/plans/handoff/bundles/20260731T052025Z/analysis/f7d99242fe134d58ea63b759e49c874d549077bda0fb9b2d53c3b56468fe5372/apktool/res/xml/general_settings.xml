<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen android:title="@string/general_settings_title" search:ignore="true"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:search="http://schemas.android.com/apk/com.bytehamster.lib.preferencesearch">
    <PreferenceScreen android:icon="@drawable/ic_monitor" android:title="@string/display_preferences" android:key="display_preferences" search:ignore="true">
        <PreferenceCategory android:title="@string/global_preferences" android:key="global_preferences">
            <com.fsck.k9.ui.settings.general.LanguagePreference android:entries="@array/language_entries" android:title="@string/settings_language_label" android:key="language" android:dialogTitle="@string/settings_language_label" android:entryValues="@array/language_values" app:useSimpleSummaryProvider="true" />
            <ListPreference android:entries="@array/theme_entries" android:title="@string/settings_theme_label" android:key="theme" android:dialogTitle="@string/settings_theme_label" android:entryValues="@array/theme_values" app:useSimpleSummaryProvider="true" />
            <CheckBoxPreference android:title="@string/settings_message_theme_selection_label" android:key="fixed_message_view_theme" android:summaryOn="@string/settings_message_theme_selection_summary_on" android:summaryOff="@string/settings_message_theme_selection_summary_off" search:summary="" />
            <ListPreference android:entries="@array/message_theme_entries" android:title="@string/settings_message_theme_label" android:key="messageViewTheme" android:dependency="fixed_message_view_theme" android:dialogTitle="@string/settings_message_theme_label" android:entryValues="@array/message_theme_values" app:useSimpleSummaryProvider="true" />
            <ListPreference android:entries="@array/message_theme_entries" android:title="@string/settings_compose_theme_label" android:key="message_compose_theme" android:dialogTitle="@string/settings_compose_theme_label" android:entryValues="@array/message_theme_values" app:useSimpleSummaryProvider="true" />
            <PreferenceScreen android:title="@string/font_size_settings_title" android:key="font_size" android:summary="@string/font_size_settings_description">
                <PreferenceCategory android:title="@string/font_size_message_list" android:key="message_list_fonts">
                    <ListPreference android:entries="@array/font_entries" android:title="@string/font_size_message_list_subject" android:key="message_list_subject_font" android:dialogTitle="@string/font_size_message_list_subject" android:entryValues="@array/font_values" app:useSimpleSummaryProvider="true" />
                    <ListPreference android:entries="@array/font_entries" android:title="@string/font_size_message_list_sender" android:key="message_list_sender_font" android:dialogTitle="@string/font_size_message_list_sender" android:entryValues="@array/font_values" app:useSimpleSummaryProvider="true" />
                    <ListPreference android:entries="@array/font_entries" android:title="@string/font_size_message_list_date" android:key="message_list_date_font" android:dialogTitle="@string/font_size_message_list_date" android:entryValues="@array/font_values" app:useSimpleSummaryProvider="true" />
                    <ListPreference android:entries="@array/font_entries" android:title="@string/font_size_message_list_preview" android:key="message_list_preview_font" android:dialogTitle="@string/font_size_message_list_preview" android:entryValues="@array/font_values" app:useSimpleSummaryProvider="true" />
                </PreferenceCategory>
                <PreferenceCategory android:title="@string/font_size_message_view" android:key="message_view_fonts">
                    <ListPreference android:entries="@array/font_entries" android:title="@string/font_size_message_view_account" android:key="message_view_account_name_font" android:dialogTitle="@string/font_size_message_view_account" android:entryValues="@array/font_values" app:useSimpleSummaryProvider="true" />
                    <ListPreference android:entries="@array/font_entries" android:title="@string/font_size_message_view_subject" android:key="message_view_subject_font" android:dialogTitle="@string/font_size_message_view_subject" android:entryValues="@array/font_values" app:useSimpleSummaryProvider="true" />
                    <ListPreference android:entries="@array/font_entries" android:title="@string/font_size_message_view_sender" android:key="message_view_sender_font" android:dialogTitle="@string/font_size_message_view_sender" android:entryValues="@array/font_values" app:useSimpleSummaryProvider="true" />
                    <ListPreference android:entries="@array/font_entries" android:title="@string/font_size_message_view_date" android:key="message_view_date_font" android:dialogTitle="@string/font_size_message_view_date" android:entryValues="@array/font_values" app:useSimpleSummaryProvider="true" />
                    <ListPreference android:entries="@array/font_entries" android:title="@string/font_size_message_view_recipients" android:key="message_view_recipients_font" android:dialogTitle="@string/font_size_message_view_recipients" android:entryValues="@array/font_values" app:useSimpleSummaryProvider="true" />
                    <SeekBarPreference android:max="250" android:title="@string/font_size_message_view_content" android:key="message_view_content_font_slider" app:min="40" app:showSeekBarValue="true" />
                </PreferenceCategory>
                <PreferenceCategory android:title="@string/font_size_message_compose" android:key="message_compose_fonts">
                    <ListPreference android:entries="@array/font_entries" android:title="@string/font_size_message_compose_input" android:key="message_compose_input_font" android:dialogTitle="@string/font_size_message_compose_input" android:entryValues="@array/font_values" app:useSimpleSummaryProvider="true" />
                </PreferenceCategory>
            </PreferenceScreen>
            <ListPreference android:entries="@array/animation_entries" android:title="@string/animations_title" android:key="animations" android:dialogTitle="@string/animations_title" android:entryValues="@array/animation_values" app:useSimpleSummaryProvider="true" />
        </PreferenceCategory>
        <PreferenceCategory android:title="@string/navigation_drawer_preferences" android:key="drawer_preferences">
            <CheckBoxPreference android:title="@string/expand_folders" android:key="drawerExpandAllFolder" />
        </PreferenceCategory>
        <PreferenceCategory android:title="@string/accountlist_preferences" android:key="accountlist_preferences">
            <CheckBoxPreference android:title="@string/show_unified_inbox_title" android:key="show_unified_inbox" />
            <CheckBoxPreference android:title="@string/show_starred_count_title" android:key="show_starred_count" />
        </PreferenceCategory>
        <PreferenceCategory android:title="@string/messagelist_preferences" android:key="messagelist_preferences">
            <ListPreference android:entries="@array/message_list_density_entries" android:title="@string/general_settings_message_list_density_title" android:key="message_list_density" android:dialogTitle="@string/general_settings_message_list_density_title" android:entryValues="@array/message_list_density_values" app:useSimpleSummaryProvider="true" />
            <ListPreference android:entries="@array/preview_lines_entries" android:title="@string/global_settings_preview_lines_label" android:key="messagelist_preview_lines" android:dialogTitle="@string/global_settings_preview_lines_label" android:entryValues="@array/preview_lines_values" app:useSimpleSummaryProvider="true" />
            <ListPreference android:entries="@array/message_list_date_time_format_entries" android:title="@string/general_settings_message_list_date_time_format_title" android:key="message_list_date_time_format" android:dialogTitle="@string/general_settings_message_list_date_time_format_title" android:entryValues="@array/message_list_date_time_format_values" app:useSimpleSummaryProvider="true" />
            <CheckBoxPreference android:title="@string/global_settings_flag_label" android:key="messagelist_stars" android:summary="@string/global_settings_flag_summary" />
            <CheckBoxPreference android:title="@string/global_settings_show_correspondent_names_label" android:key="messagelist_show_correspondent_names" android:summary="@string/global_settings_show_correspondent_names_summary" />
            <CheckBoxPreference android:title="@string/global_settings_sender_above_subject_label" android:key="messagelist_sender_above_subject" android:summary="@string/global_settings_sender_above_subject_summary" />
            <CheckBoxPreference android:title="@string/global_settings_show_contact_name_label" android:key="messagelist_show_contact_name" android:summary="@string/global_settings_show_contact_name_summary" android:dependency="messagelist_show_correspondent_names" />
            <CheckBoxPreference android:title="@string/global_settings_registered_name_color_label" android:key="messagelist_change_contact_name_color" android:summary="@string/global_settings_registered_name_color_changed" android:dependency="messagelist_show_contact_name" />
            <com.takisoft.preferencex.ColorPickerPreference android:title="@string/general_settings_contact_name_color_label" android:key="messagelist_contact_name_color" android:dependency="messagelist_change_contact_name_color" android:defaultValue="#FF1093F5" />
            <CheckBoxPreference android:title="@string/global_settings_show_contact_picture_label" android:key="messagelist_show_contact_picture" android:summary="@string/global_settings_show_contact_picture_summary" />
            <CheckBoxPreference android:title="@string/global_settings_colorize_missing_contact_pictures_label" android:key="messagelist_colorize_missing_contact_pictures" android:summary="@string/global_settings_colorize_missing_contact_pictures_summary" android:dependency="messagelist_show_contact_picture" />
            <CheckBoxPreference android:title="@string/global_settings_background_as_unread_indicator_label" android:key="messagelist_background_as_unread_indicator" android:summary="@string/global_settings_background_as_unread_indicator_summary" />
            <CheckBoxPreference android:title="@string/global_settings_threaded_view_label" android:key="threaded_view" android:summary="@string/global_settings_threaded_view_summary" />
            <CheckBoxPreference android:title="@string/general_settings_show_compose_button_title" android:key="show_compose_button" />
            <ListPreference android:entries="@array/splitview_mode_entries" android:title="@string/global_settings_splitview_mode_label" android:key="splitview_mode" android:dialogTitle="@string/global_settings_splitview_mode_label" android:entryValues="@array/splitview_mode_values" app:useSimpleSummaryProvider="true" />
        </PreferenceCategory>
        <PreferenceCategory android:title="@string/messageview_preferences" android:key="messageview_preferences">
            <CheckBoxPreference android:title="@string/global_settings_messageview_fixedwidth_label" android:key="messageview_fixedwidth_font" android:summary="@string/global_settings_messageview_fixedwidth_summary" />
            <MultiSelectListPreference android:entries="@array/messageview_visible_refile_actions_entries" android:title="@string/global_settings_messageview_visible_refile_actions_title" android:key="messageview_visible_refile_actions" android:summary="@string/global_settings_messageview_visible_refile_actions_summary" android:dialogTitle="@string/global_settings_messageview_visible_refile_actions_title" android:entryValues="@array/messageview_visible_refile_actions_values" />
            <CheckBoxPreference android:title="@string/global_settings_messageview_autofit_width_label" android:key="messageview_autofit_width" android:summary="@string/global_settings_messageview_autofit_width_summary" />
            <ListPreference android:entries="@array/messageview_body_content_type_entries" android:title="@string/global_settings_messageview_body_content_type_title" android:key="messageview_body_content_type" android:dialogTitle="@string/global_settings_messageview_body_content_type_title" android:entryValues="@array/messageview_body_content_type_values" app:useSimpleSummaryProvider="true" />
        </PreferenceCategory>
    </PreferenceScreen>
    <PreferenceScreen android:icon="@drawable/ic_touch_app" android:title="@string/interaction_preferences" android:key="interaction_preferences" search:ignore="true">
        <CheckBoxPreference android:title="@string/volume_navigation_title_short" android:key="volume_navigation" android:summary="@string/volume_navigation_summary" />
        <ListPreference android:entries="@array/post_remove_navigation_entries" android:title="@string/general_settings_post_remove_action_title" android:key="post_remove_navigation" android:dialogTitle="@string/general_settings_post_remove_action_title" android:entryValues="@array/post_remove_navigation_values" app:useSimpleSummaryProvider="true" />
        <ListPreference android:entries="@array/post_mark_as_unread_navigation_entries" android:title="@string/general_settings_post_mark_as_unread_action_title" android:key="post_mark_as_unread_navigation" android:dialogTitle="@string/general_settings_post_mark_as_unread_action_title" android:entryValues="@array/post_mark_as_unread_navigation_values" app:useSimpleSummaryProvider="true" />
        <MultiSelectListPreference android:entries="@array/confirm_action_entries" android:title="@string/global_settings_confirm_actions_title" android:key="confirm_actions" android:summary="@string/global_settings_confirm_actions_summary" android:dialogTitle="@string/global_settings_confirm_actions_title" android:entryValues="@array/confirm_action_values" />
        <PreferenceScreen android:title="@string/general_settings_swipe_actions_title" android:key="swipe_actions" search:ignore="true">
            <ListPreference android:entries="@array/swipe_action_names" android:title="@string/general_settings_right_swipe_title" android:key="swipe_action_right" android:dialogTitle="@string/general_settings_right_swipe_title" android:entryValues="@array/swipe_action_values" app:useSimpleSummaryProvider="true" />
            <ListPreference android:entries="@array/swipe_action_names" android:title="@string/general_settings_left_swipe_title" android:key="swipe_action_left" android:dialogTitle="@string/general_settings_left_swipe_title" android:entryValues="@array/swipe_action_values" app:useSimpleSummaryProvider="true" />
        </PreferenceScreen>
    </PreferenceScreen>
    <PreferenceScreen android:icon="@drawable/ic_notifications" android:title="@string/notifications_title" android:key="notification_preferences" search:ignore="true">
        <CheckBoxPreference android:title="@string/quiet_time" android:key="quiet_time_enabled" android:summary="@string/quiet_time_description" />
        <CheckBoxPreference android:title="@string/quiet_time_notification" android:key="disable_notifications_during_quiet_time" android:summary="@string/quiet_time_notification_description" android:dependency="quiet_time_enabled" />
        <com.takisoft.preferencex.TimePickerPreference android:title="@string/quiet_time_starts" android:key="quiet_time_starts" android:dependency="quiet_time_enabled" app:pref_hourFormat="h24" app:pref_summaryHasTime="%s" search:summary="" />
        <com.takisoft.preferencex.TimePickerPreference android:title="@string/quiet_time_ends" android:key="quiet_time_ends" android:dependency="quiet_time_enabled" app:pref_hourFormat="h24" app:pref_summaryHasTime="%s" search:summary="" />
        <ListPreference android:entries="@array/lock_screen_notification_visibility_entries" android:title="@string/global_settings_lock_screen_notification_visibility_title" android:key="lock_screen_notification_visibility" android:dialogTitle="@string/global_settings_lock_screen_notification_visibility_title" android:entryValues="@array/lock_screen_notification_visibility_values" app:useSimpleSummaryProvider="true" />
        <Preference android:title="@string/notification_actions_settings_title" android:key="notification_actions_settings" android:summary="@string/notification_actions_settings_summary" />
        <CheckBoxPreference android:title="@string/notification_summary_delete_title" android:key="notification_summary_delete" android:summary="@string/notification_summary_delete_summary" />
        <SwitchPreferenceCompat android:title="@string/notification_show_contact_picture_title" android:key="notification_show_contact_picture" android:summary="@string/notification_show_contact_picture_summary" />
    </PreferenceScreen>
    <PreferenceScreen android:icon="@drawable/ic_swap_vert" android:title="@string/network_preferences" android:key="network_preferences" search:ignore="true">
        <ListPreference android:entries="@array/background_ops_entries" android:title="@string/background_ops_label" android:key="background_ops" android:dialogTitle="@string/background_ops_label" android:entryValues="@array/background_ops_values" app:useSimpleSummaryProvider="true" />
    </PreferenceScreen>
    <PreferenceScreen android:icon="@drawable/ic_security" android:title="@string/privacy_preferences" android:key="privacy_preferences" search:ignore="true">
        <CheckBoxPreference android:title="@string/global_settings_privacy_hide_useragent" android:key="privacy_hide_useragent" android:summary="@string/global_settings_privacy_hide_useragent_detail" />
        <CheckBoxPreference android:title="@string/global_settings_privacy_hide_timezone" android:key="privacy_hide_timezone" android:summary="@string/global_settings_privacy_hide_timezone_detail" />
    </PreferenceScreen>
    <PreferenceScreen android:icon="@drawable/ic_analytics" android:title="@string/settings_ui_data_collection" android:key="data_collection" search:ignore="true">
        <SwitchPreference android:title="@string/settings_ui_telemetry_title" android:key="enable_telemetry" android:summary="@string/settings_ui_telemetry_description" />
    </PreferenceScreen>
    <PreferenceScreen android:icon="@drawable/ic_bug_report" android:title="@string/debug_preferences" android:key="debug_preferences" search:ignore="true">
        <CheckBoxPreference android:title="@string/debug_enable_debug_logging_title" android:key="debug_logging" android:summary="@string/debug_enable_debug_logging_summary" />
        <CheckBoxPreference android:title="@string/debug_enable_sync_debug_logging_title" android:key="sync_debug_logging" android:summary="@string/debug_enable_sync_debug_logging_summary" />
        <CheckBoxPreference android:title="@string/debug_enable_sensitive_logging_title" android:key="sensitive_logging" android:summary="@string/debug_enable_sensitive_logging_summary" />
        <Preference android:title="@string/debug_open_secret_debug_screen" android:key="debug_secret_debug_screen" />
    </PreferenceScreen>
</PreferenceScreen>
