<?xml version="1.0" encoding="utf-8"?>
<com.takisoft.datetimepicker.widget.internal.DialogViewAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:id="@+id/animator"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:measureAllChildren="true"
    android:inAnimation="@anim/date_picker_fade_in_material"
    android:outAnimation="@anim/date_picker_fade_out_material">
    <com.takisoft.datetimepicker.widget.DayPickerView
        android:id="@+id/date_picker_day_picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <com.takisoft.datetimepicker.widget.YearPickerView
        android:id="@+id/date_picker_year_picker"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollIndicators="bottom"/>
</com.takisoft.datetimepicker.widget.internal.DialogViewAnimator>
