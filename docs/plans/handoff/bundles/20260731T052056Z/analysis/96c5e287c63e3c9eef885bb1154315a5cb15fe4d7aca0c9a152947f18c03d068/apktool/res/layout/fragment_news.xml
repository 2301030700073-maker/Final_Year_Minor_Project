<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.appbar.AppBarLayout android:id="@id/app_bar_layout" android:layout_width="match_parent" android:layout_height="@dimen/readingListLeadHeight">
        <com.google.android.material.appbar.CollapsingToolbarLayout android:id="@id/toolbar_container" android:layout_width="match_parent" android:layout_height="match_parent" app:contentScrim="?paper_color" app:layout_scrollFlags="scroll|exitUntilCollapsed|snap">
