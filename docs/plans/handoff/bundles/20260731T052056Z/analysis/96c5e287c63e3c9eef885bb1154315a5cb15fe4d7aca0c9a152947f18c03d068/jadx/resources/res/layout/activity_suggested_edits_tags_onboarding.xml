<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.wikipedia.onboarding.OnboardingPageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:centeredImage="?attr/image_tags_onboarding_drawables"
        app:imageSize="160dp"
        app:primaryText="@string/suggested_edits_image_tags_onboarding_title"
        app:secondaryText="@string/suggested_edits_image_tags_onboarding_text"
        app:tertiaryText="@string/suggested_edits_image_tags_onboarding_note"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="?attr/border_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:layout_gravity="end"
                android:id="@+id/onboarding_done_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_get_started"
                style="@style/App.Button.Text"/>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
