<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/dialogDetailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:animateLayoutChanges="true">
            <LinearLayout
                android:id="@+id/toolbarView"
                android:background="?attr/selectableItemBackground"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp">
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/downChevron"
                    android:padding="12dp"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@null"
                    android:scaleY="-1"
                    app:srcCompat="@drawable/ic_keyboard_arrow_up_black_24dp"
                    app:tint="?attr/placeholder_color"/>
                <TextView
                    android:textSize="14sp"
                    android:textColor="?attr/primary_color"
                    android:ellipsize="end"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/titleText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:maxLines="3"
                    android:layout_weight="1"
                    android:lineSpacingExtra="6sp"
                    android:fontFamily="serif"
                    android:layout_marginEnd="16dp"/>
            </LinearLayout>
            <org.wikipedia.commons.FilePageView
                android:orientation="vertical"
                android:id="@+id/filePageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
            <org.wikipedia.page.linkpreview.LinkPreviewErrorView
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:id="@+id/errorView"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
</LinearLayout>
