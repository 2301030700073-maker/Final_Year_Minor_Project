<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="14sp"
        android:textColor="?android:attr/textColorPrimary"
        android:gravity="center_vertical"
        android:background="?attr/border_color"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="@string/insert_media_advanced_settings_image_type"
        android:lineSpacingExtra="7sp"
        android:fontFamily="sans-serif-medium"
        android:paddingHorizontal="16dp"/>
    <LinearLayout
        android:id="@+id/imageTypeThumbnail"
        style="@style/SideDrawerMenuItem">
        <TextView
            android:tag="text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/insert_media_advanced_settings_image_type_thumbnail"
            android:layout_weight="1"
            style="@android:style/TextAppearance"/>
        <ImageView
            android:tag="check"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_check_black_24dp"
            app:tint="?attr/progressive_color"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/imageTypeFrame"
        style="@style/SideDrawerMenuItem">
        <TextView
            android:tag="text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/insert_media_advanced_settings_image_type_frame"
            android:layout_weight="1"
            style="@android:style/TextAppearance"/>
        <ImageView
            android:tag="check"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_check_black_24dp"
            app:tint="?attr/progressive_color"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/imageTypeFrameless"
        style="@style/SideDrawerMenuItem">
        <TextView
            android:tag="text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/insert_media_advanced_settings_image_type_frameless"
            android:layout_weight="1"
            style="@android:style/TextAppearance"/>
        <ImageView
            android:tag="check"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_check_black_24dp"
            app:tint="?attr/progressive_color"/>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/imageTypeBasic"
        style="@style/SideDrawerMenuItem">
        <TextView
            android:tag="text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/insert_media_advanced_settings_image_type_basic"
            android:layout_weight="1"
            style="@android:style/TextAppearance"/>
        <ImageView
            android:tag="check"
            android:visibility="gone"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            app:srcCompat="@drawable/ic_check_black_24dp"
            app:tint="?attr/progressive_color"/>
    </LinearLayout>
    <TextView
        android:textSize="12sp"
        android:tag="text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="@string/insert_media_advanced_settings_image_type_tip"/>
</LinearLayout>
