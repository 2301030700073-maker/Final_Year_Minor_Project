<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:id="@+id/userInformationContainer"
            android:paddingLeft="24dp"
            android:paddingTop="12dp"
            android:paddingRight="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="24dp">
            <TextView
                android:id="@+id/userTenure"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/patroller_tasks_edits_list_user_information_dialog_joined_date_text"
                android:drawablePadding="8dp"
                android:paddingVertical="12dp"
                app:drawableStartCompat="@drawable/ic_timer_black_24dp"
                app:drawableTint="?attr/progressive_color"
                style="@style/P.MaterialListTitle"/>
            <TextView
                android:id="@+id/editCount"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/patroller_tasks_edits_list_user_information_dialog_edit_count_text"
                android:drawablePadding="8dp"
                android:paddingVertical="12dp"
                app:drawableStartCompat="@drawable/ic_mode_edit_white_24dp"
                app:drawableTint="?attr/progressive_color"
                style="@style/P.MaterialListTitle"/>
        </LinearLayout>
        <ProgressBar
            android:layout_gravity="center"
            android:id="@+id/dialogProgressBar"
            android:paddingTop="16dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <org.wikipedia.views.WikiErrorView
            android:layout_gravity="center_horizontal"
            android:id="@+id/dialogErrorView"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
    </FrameLayout>
</ScrollView>
