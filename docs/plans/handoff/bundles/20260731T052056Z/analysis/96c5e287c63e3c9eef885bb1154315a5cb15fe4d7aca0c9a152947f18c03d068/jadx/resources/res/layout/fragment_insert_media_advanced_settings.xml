<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/insertMediaPreviewContainer"
    android:background="?attr/paper_color"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp">
        <com.google.android.material.materialswitch.MaterialSwitch
            android:textColor="?attr/primary_color"
            android:gravity="center_vertical"
            android:id="@+id/wrapImageSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/insert_media_advanced_settings_wrap_image"/>
        <View
            android:background="?attr/list_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/primary_color"
                android:id="@+id/imagePosition"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/insert_media_advanced_settings_image_position"
                android:layout_weight="0.7"/>
            <TextView
                android:textColor="?attr/progressive_color"
                android:id="@+id/imagePositionButton"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/insert_media_advanced_settings_image_position_right"
                android:layout_weight="0.3"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="textEnd"
                android:paddingVertical="16dp"/>
        </LinearLayout>
        <View
            android:background="?attr/list_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/primary_color"
                android:id="@+id/imageType"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/insert_media_advanced_settings_image_type"
                android:layout_weight="0.7"/>
            <TextView
                android:textColor="?attr/progressive_color"
                android:id="@+id/imageTypeButton"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/insert_media_advanced_settings_image_type_thumbnail"
                android:layout_weight="0.3"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="textEnd"
                android:paddingVertical="16dp"/>
        </LinearLayout>
        <View
            android:background="?attr/list_divider"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/primary_color"
                android:id="@+id/imageSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/insert_media_advanced_settings_image_size"
                android:layout_weight="0.7"/>
            <TextView
                android:textColor="?attr/progressive_color"
                android:id="@+id/imageSizeButton"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:paddingTop="16dp"
                android:paddingBottom="16dp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/insert_media_advanced_settings_image_size_custom"
                android:layout_weight="0.3"
                android:fontFamily="sans-serif-medium"
                android:textAlignment="textEnd"
                android:paddingVertical="16dp"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
