<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/insertMediaPreviewContainer"
    android:background="?attr/paper_color"
    android:visibility="gone"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:layout_marginHorizontal="16dp">
        <TextView
            android:textColor="?attr/primary_color"
            android:id="@+id/templateDataTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            app:drawableStartCompat="@drawable/ic_puzzle"
            app:drawableTint="?attr/primary_color"
            style="@style/H1"/>
        <TextView
            android:textColor="?attr/secondary_color"
            android:id="@+id/templateDataDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            style="@style/P"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/templateDataMissing"
            android:background="?attr/background_color"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/primary_color"
                android:id="@+id/templateDataMissingText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="6sp"/>
        </LinearLayout>
        <TextView
            android:textColor="?attr/progressive_color"
            android:id="@+id/templateDataLearnMoreButton"
            android:background="?android:attr/selectableItemBackground"
            android:padding="8dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/templates_learn_more_link"
            android:drawablePadding="8dp"
            android:layout_marginStart="-8dp"
            app:drawableEndCompat="@drawable/ic_open_in_new_black_24px"
            app:drawableTint="?attr/progressive_color"
            style="@style/H3.Button"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/templateDataParamsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"/>
    </LinearLayout>
</ScrollView>
