<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="?attr/paper_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:layout_gravity="top"
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"/>
    <org.wikipedia.views.WikiErrorView
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/errorView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>
    <include
        android:id="@+id/shareLayout"
        layout="@layout/view_on_this_day_game_share"/>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContainer"
        android:background="?attr/paper_color"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp">
            <androidx.cardview.widget.CardView
                android:id="@+id/resultTextContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <LinearLayout
                    android:gravity="center"
                    android:orientation="vertical"
                    android:id="@+id/resultCardContainer"
                    android:background="@color/green600"
                    android:paddingLeft="16dp"
                    android:paddingTop="24dp"
                    android:paddingRight="16dp"
                    android:paddingBottom="24dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="24dp">
                    <TextView
                        android:textColor="@color/gray700"
                        android:id="@+id/resultText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/H1.Article"/>
                    <TextView
                        android:textColor="@color/gray700"
                        android:id="@+id/nextGameText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:drawablePadding="6dp"
                        app:drawableStartCompat="@drawable/ic_time_24"
                        app:drawableTint="@color/gray700"
                        style="@style/P"/>
                    <com.google.android.material.button.MaterialButton
                        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                        android:textColor="@color/white"
                        android:id="@+id/shareButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="8dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginRight="8dp"
                        android:text="@string/on_this_day_game_share_button"
                        android:elevation="3dp"
                        android:stateListAnimator="@null"
                        android:layout_marginHorizontal="8dp"
                        app:icon="@drawable/ic_share"
                        app:iconSize="18dp"
                        app:iconTint="@color/white"
                        app:rippleColor="?attr/placeholder_color"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <com.google.android.material.button.MaterialButton
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/progressive_color"
                android:id="@+id/archiveGameButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/on_this_day_game_archive_btn_text"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:textAllCaps="false"
                app:backgroundTint="?attr/paper_color"
                app:cornerRadius="100dp"
                app:icon="@drawable/outline_calendar_clock_24"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="?attr/progressive_color"
                app:layout_constraintEnd_toEndOf="@+id/resultTextContainer"
                app:layout_constraintStart_toStartOf="@+id/resultTextContainer"
                app:layout_constraintTop_toBottomOf="@+id/resultTextContainer"
                app:strokeColor="?attr/border_color"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall.Emphasized"
                android:textColor="?attr/primary_color"
                android:id="@+id/yourStatsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:text="@string/on_this_day_game_your_stats"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/archiveGameButton"/>
            <androidx.compose.ui.platform.ComposeView
                android:id="@+id/gameStatsComposeView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginRight="16dp"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/yourStatsText"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall.Emphasized"
                android:textColor="?attr/primary_color"
                android:id="@+id/resultSubtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginRight="16dp"
                android:text="@string/on_this_day_game_result_subtitle"
                android:layout_marginHorizontal="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/gameStatsComposeView"/>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/resultArticlesList"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/resultSubtitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
