<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/edit_preview_container"
    android:background="?attr/paper_color"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.wikipedia.views.ObservableWebView
        android:id="@+id/edit_preview_webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <FrameLayout
        android:layout_gravity="bottom"
        android:background="?attr/paper_color"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:background="?attr/border_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <TextView
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="?attr/secondary_color"
            android:id="@+id/licenseText"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:drawablePadding="8dp"
            android:lineSpacingMultiplier="1.2"
            app:drawableStartCompat="@drawable/ic_license_cc"
            app:drawableTint="?attr/secondary_color"/>
    </FrameLayout>
</FrameLayout>
