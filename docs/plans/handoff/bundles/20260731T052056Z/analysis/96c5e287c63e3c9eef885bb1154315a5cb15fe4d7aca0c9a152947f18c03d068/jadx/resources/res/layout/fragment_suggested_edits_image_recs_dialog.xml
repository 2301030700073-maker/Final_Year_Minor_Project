<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/imageRecommendationDialogContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/secondary_color"
            android:id="@+id/instructionSubText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/image_recommendation_reject_subtitle"
            android:layout_marginStart="6dp"/>
        <View
            android:background="?attr/border_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="8dp"/>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:textColor="?attr/primary_color"
            android:id="@+id/checkBox1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/image_recommendation_reject_not_relevant"/>
        <View
            android:background="?attr/border_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:textColor="?attr/primary_color"
            android:id="@+id/checkBox2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/image_recommendation_reject_no_info"/>
        <View
            android:background="?attr/border_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:textColor="?attr/primary_color"
            android:id="@+id/checkBox3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/image_recommendation_reject_offensive"/>
        <View
            android:background="?attr/border_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:textColor="?attr/primary_color"
            android:id="@+id/checkBox4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/image_recommendation_reject_low_quality"/>
        <View
            android:background="?attr/border_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:textColor="?attr/primary_color"
            android:id="@+id/checkBox5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/image_recommendation_reject_dont_know"/>
        <View
            android:background="?attr/border_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"/>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:textColor="?attr/primary_color"
            android:id="@+id/checkBox6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/image_recommendation_reject_other"/>
    </LinearLayout>
</ScrollView>
