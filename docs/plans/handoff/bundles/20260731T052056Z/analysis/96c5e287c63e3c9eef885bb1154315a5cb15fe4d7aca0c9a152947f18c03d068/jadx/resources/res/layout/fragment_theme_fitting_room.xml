<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fragment_theme_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <org.wikipedia.views.WikiCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textColor="?attr/primary_color"
                android:id="@+id/theme_test_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="@string/color_theme_test_title"
                android:fontFamily="serif"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp">
                <TextView
                    android:textColor="?attr/primary_color"
                    android:id="@+id/theme_test_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/color_theme_test_text"
                    android:layout_weight="1"
                    android:lineSpacingExtra="8sp"/>
                <ImageView
                    android:id="@+id/theme_test_image"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:src="@drawable/w_nav_mark"
                    android:scaleType="centerInside"
                    android:contentDescription="@null"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>
        </LinearLayout>
    </org.wikipedia.views.WikiCardView>
</FrameLayout>
