<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/temp_account_info_container"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="16dp"
    android:layout_marginRight="16dp"
    android:layout_marginHorizontal="16dp">
    <View
        android:background="?attr/border_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginBottom="8dp"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/temp_account_info_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        app:srcCompat="@drawable/ic_temp_account"
        app:tint="?attr/secondary_color"/>
    <TextView
        android:textColor="?attr/secondary_color"
        android:id="@+id/temp_account_info_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="@string/temp_account_edit_status"
        android:lineSpacingExtra="4dp"
        android:layout_marginStart="36dp"
        android:layout_marginVertical="16dp"/>
</FrameLayout>
