<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="?attr/border_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>
    <TextView
        android:textColor="?attr/primary_color"
        android:textColorLink="?attr/progressive_color"
        android:id="@+id/hCaptchaDisclaimer"
        android:padding="5dp"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        android:lineSpacingExtra="4dp"
        android:textAlignment="center"
        android:layout_marginHorizontal="16dp"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp">
        <TextView
            android:textColor="?attr/progressive_color"
            android:id="@+id/forgot_password_link"
            android:background="?android:attr/selectableItemBackground"
            android:padding="5dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_forgot_password"/>
        <TextView
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="•"
            android:paddingStart="3dp"
            android:paddingEnd="3dp"/>
        <TextView
            android:textColor="?attr/progressive_color"
            android:id="@+id/privacy_policy_link"
            android:background="?android:attr/selectableItemBackground"
            android:padding="5dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/privacy_policy_description"/>
    </LinearLayout>
    <FrameLayout
        android:id="@+id/temp_account_info_container"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp">
        <View
            android:background="?attr/border_color"
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginBottom="8dp"/>
        <ImageView
            android:layout_gravity="center_vertical"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@null"
            android:layout_marginStart="12dp"
            app:srcCompat="@drawable/ic_temp_account"
            app:tint="?attr/secondary_color"/>
        <TextView
            android:textColor="?attr/secondary_color"
            android:id="@+id/temp_account_info_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:text="@string/temp_account_login_status"
            android:lineSpacingExtra="4dp"
            android:layout_marginStart="48dp"
            android:layout_marginVertical="16dp"/>
    </FrameLayout>
</LinearLayout>
