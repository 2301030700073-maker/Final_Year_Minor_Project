<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <org.wikipedia.views.LangCodeView
        android:layout_gravity="center_vertical"
        android:id="@+id/recentEditsFilterLanguageCode"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="-10dp"
        app:backgroundTint="?attr/placeholder_color"
        app:textColor="?attr/placeholder_color"/>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/recentEditsFilterWikiLogo"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:scaleType="center"
        android:contentDescription="@null"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="-10dp"
        app:tint="?attr/placeholder_color"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingStart="24dp"
        android:paddingEnd="8dp"
        android:paddingVertical="12dp">
        <TextView
            android:id="@+id/recentEditsFilterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/P.MaterialListTitle"/>
        <TextView
            android:id="@+id/recentEditsFilterDesc"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            style="@style/List.MaterialListSubtitle"/>
    </LinearLayout>
    <ImageView
        android:layout_gravity="center_vertical"
        android:id="@+id/recentEditsFilterCheck"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:scaleType="center"
        android:contentDescription="@null"
        android:layout_marginEnd="14dp"
        app:srcCompat="@drawable/ic_baseline_radio_button_checked_24"
        app:tint="?attr/progressive_color"/>
</merge>
