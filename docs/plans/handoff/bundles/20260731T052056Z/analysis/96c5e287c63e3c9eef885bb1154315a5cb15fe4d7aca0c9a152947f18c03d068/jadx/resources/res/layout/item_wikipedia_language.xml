<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/placeholder_color"
        android:gravity="center"
        android:id="@+id/wiki_language_order"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:fontFamily="sans-serif-medium"
        android:textAlignment="center"
        android:layout_marginStart="6dp"/>
    <CheckBox
        android:gravity="center"
        android:id="@+id/wiki_language_checkbox"
        android:visibility="gone"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="-8dp"/>
    <org.wikipedia.views.LangCodeView
        android:layout_gravity="center_vertical"
        android:id="@+id/wiki_language_code"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:layout_marginStart="14dp"
        app:backgroundTint="?attr/placeholder_color"
        app:textColor="?attr/placeholder_color"/>
    <TextView
        android:layout_gravity="center_vertical"
        android:id="@+id/wiki_language_title"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        style="@style/P.MaterialListTitle"/>
    <ImageView
        android:id="@+id/wiki_language_drag_handle"
        android:layout_width="56dp"
        android:layout_height="match_parent"
        android:scaleType="center"
        android:contentDescription="@null"
        app:srcCompat="@drawable/ic_draggable"
        app:tint="?attr/placeholder_color"/>
</merge>
