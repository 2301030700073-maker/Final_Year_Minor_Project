<?xml version="1.0" encoding="utf-8"?>
<org.wikipedia.views.WikiCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overflowContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="-2dp"
    android:layout_marginEnd="2dp"
    app:cardUseCompatPadding="true">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:background="?attr/paper_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/primary_color"
                android:paddingLeft="16dp"
                android:paddingTop="13dp"
                android:paddingRight="16dp"
                android:paddingBottom="13dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/page_edit_history_filter_by"
                android:paddingHorizontal="16dp"
                android:paddingVertical="13dp"/>
            <LinearLayout
                android:id="@+id/filterByAllButton"
                android:background="?android:attr/selectableItemBackground"
                android:paddingLeft="16dp"
                android:paddingTop="13dp"
                android:paddingRight="16dp"
                android:paddingBottom="13dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="13dp">
                <ImageView
                    android:id="@+id/filterByAllSelected"
                    android:visibility="invisible"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_black_24dp"
                    android:contentDescription="@null"
                    app:tint="?attr/placeholder_color"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="?attr/primary_color"
                    android:id="@+id/filterByAll"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/page_edit_history_filter_by_all"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/filterByUserButton"
                android:background="?android:attr/selectableItemBackground"
                android:paddingLeft="16dp"
                android:paddingTop="13dp"
                android:paddingRight="16dp"
                android:paddingBottom="13dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="13dp">
                <ImageView
                    android:id="@+id/filterByUserSelected"
                    android:visibility="invisible"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_black_24dp"
                    android:contentDescription="@null"
                    app:tint="?attr/placeholder_color"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="?attr/primary_color"
                    android:id="@+id/filterByUser"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/page_edit_history_filter_by_user"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_user_avatar"
                    android:contentDescription="@null"
                    app:tint="?android:attr/textColorTertiary"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/filterByAnonButton"
                android:background="?android:attr/selectableItemBackground"
                android:paddingLeft="16dp"
                android:paddingTop="13dp"
                android:paddingRight="16dp"
                android:paddingBottom="13dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="13dp">
                <ImageView
                    android:id="@+id/filterByAnonSelected"
                    android:visibility="invisible"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_black_24dp"
                    android:contentDescription="@null"
                    app:tint="?attr/placeholder_color"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="?attr/primary_color"
                    android:id="@+id/filterByAnon"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/page_edit_history_filter_by_anon"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_temp_account"
                    android:contentDescription="@null"
                    app:tint="?android:attr/textColorTertiary"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center_vertical"
                android:id="@+id/filterByBotButton"
                android:background="?android:attr/selectableItemBackground"
                android:paddingLeft="16dp"
                android:paddingTop="13dp"
                android:paddingRight="16dp"
                android:paddingBottom="13dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="13dp">
                <ImageView
                    android:id="@+id/filterByBotSelected"
                    android:visibility="invisible"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_check_black_24dp"
                    android:contentDescription="@null"
                    app:tint="?android:attr/textColorHint"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="?android:attr/textColorTertiary"
                    android:id="@+id/filterByBot"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/page_edit_history_filter_by_bot"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"/>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_robot_24"
                    android:contentDescription="@null"
                    app:tint="?android:attr/textColorHint"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</org.wikipedia.views.WikiCardView>
