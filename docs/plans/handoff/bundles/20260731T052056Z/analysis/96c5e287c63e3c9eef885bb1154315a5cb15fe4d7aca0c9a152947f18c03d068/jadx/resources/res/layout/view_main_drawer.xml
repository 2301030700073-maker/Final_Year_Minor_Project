<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <LinearLayout
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/main_drawer_account_container"
                android:background="?attr/selectableItemBackground"
                android:layout_width="match_parent"
                android:layout_height="48dp">
                <ImageView
                    android:id="@+id/main_drawer_account_avatar"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    android:layout_marginStart="16dp"
                    app:srcCompat="@drawable/ic_baseline_person_24"/>
                <TextView
                    android:id="@+id/main_drawer_account_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    style="@android:style/TextAppearance"/>
                <TextView
                    android:textSize="16sp"
                    android:textColor="?attr/placeholder_color"
                    android:gravity="center"
                    android:id="@+id/main_drawer_login_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="?attr/actionBarSize"
                    android:text="@string/main_drawer_login"
                    android:fontFamily="sans-serif-medium"
                    android:layout_marginStart="24dp"/>
            </LinearLayout>
            <View
                android:background="?attr/border_color"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <LinearLayout
                android:id="@+id/main_drawer_temp_account_container"
                android:clickable="false"
                style="@style/SideDrawerMenuItem">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_temp_account"
                    app:tint="?attr/secondary_color"/>
                <TextView
                    android:id="@+id/temp_account_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    style="@android:style/TextAppearance"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/main_drawer_contribs_container"
                style="@style/SideDrawerMenuItem">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_icon_user_contributions_ooui"
                    app:tint="?attr/secondary_color"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/user_contrib_menu_label"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    style="@android:style/TextAppearance"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/main_drawer_edit_container"
                android:visibility="gone"
                style="@style/SideDrawerMenuItem">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/selector_nav_edits"
                    app:tint="?attr/secondary_color"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/suggested_edits_activity_title"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    style="@android:style/TextAppearance"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/main_drawer_talk_container"
                style="@style/SideDrawerMenuItem">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_user_talk"
                    app:tint="?attr/secondary_color"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/talk_title"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    style="@android:style/TextAppearance"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/main_drawer_watchlist_container"
                style="@style/SideDrawerMenuItem">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/watchlist"
                    app:tint="?attr/secondary_color"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/watchlist_title"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    style="@android:style/TextAppearance"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/main_drawer_games_hub_container"
                style="@style/SideDrawerMenuItem">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_esports_24"
                    app:tint="?attr/secondary_color"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/games_hub_activity_title"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    style="@android:style/TextAppearance"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/main_drawer_places_container"
                style="@style/SideDrawerMenuItem">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/baseline_location_on_24"
                    app:tint="?attr/secondary_color"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/places_title"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    style="@android:style/TextAppearance"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/main_drawer_settings_container"
                style="@style/SideDrawerMenuItem">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_settings_black_24dp"
                    app:tint="?attr/secondary_color"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_item_preferences"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    style="@android:style/TextAppearance"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/main_drawer_donate_container"
                style="@style/SideDrawerMenuItem">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/ic_heart_24"
                    app:tint="?attr/secondary_color"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_item_donate"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    style="@android:style/TextAppearance"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/main_drawer_year_in_review_container"
                android:visibility="gone"
                style="@style/SideDrawerMenuItem">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@null"
                    app:srcCompat="@drawable/baseline_event_repeat_24"
                    app:tint="?attr/secondary_color"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/nav_item_year_in_review"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"
                    style="@android:style/TextAppearance"/>
                <View
                    android:id="@+id/yearInReviewRedDot"
                    android:background="@drawable/shape_circle"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="?attr/destructive_color"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
