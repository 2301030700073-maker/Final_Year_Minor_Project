<?xml version="1.0" encoding="utf-8"?>
<org.wikipedia.views.WikiCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overflow_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="-2dp"
    android:layout_marginEnd="2dp"
    app:cardUseCompatPadding="true">
    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:minWidth="180dp">
        <LinearLayout
            android:orientation="vertical"
            android:background="?attr/paper_color"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/overflow_view_primary"
                android:visibility="gone"
                android:drawablePadding="16dp"
                style="@style/OverflowMenuItem"/>
            <TextView
                android:id="@+id/overflow_view_secondary"
                android:visibility="gone"
                android:drawablePadding="16dp"
                style="@style/OverflowMenuItem"/>
            <TextView
                android:id="@+id/overflow_view_secondary_talk"
                android:visibility="gone"
                android:drawablePadding="16dp"
                app:drawableStartCompat="@drawable/ic_notification_thanks"
                app:drawableTint="?attr/secondary_color"
                style="@style/OverflowMenuItem"/>
            <TextView
                android:id="@+id/overflow_view_tertiary"
                android:visibility="gone"
                android:drawablePadding="16dp"
                app:drawableTint="?attr/secondary_color"
                style="@style/OverflowMenuItem"/>
            <TextView
                android:id="@+id/overflow_mark_as_read"
                android:text="@string/notifications_menu_mark_as_read"
                android:drawablePadding="16dp"
                app:drawableStartCompat="@drawable/ic_outline_markunread_24"
                app:drawableTint="?attr/secondary_color"
                style="@style/OverflowMenuItem"/>
        </LinearLayout>
    </ScrollView>
</org.wikipedia.views.WikiCardView>
