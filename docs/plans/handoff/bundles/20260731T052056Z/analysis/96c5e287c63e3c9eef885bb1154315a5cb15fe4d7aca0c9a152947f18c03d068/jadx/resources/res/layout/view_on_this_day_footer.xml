<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/linear_layout"
    android:background="?attr/paper_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/primary_color"
        android:gravity="center_vertical"
        android:id="@+id/end_of_scroll_message"
        android:clickable="false"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/on_this_day_end_of_scroll_message"
        android:layout_marginStart="16dp"
        android:letterSpacing="0"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/back_to_future_text_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/on_this_day_back_to_future"
        android:layout_marginStart="16dp"
        app:icon="@drawable/ic_baseline_arrow_up_alt_24"
        app:iconGravity="end"/>
</LinearLayout>
