<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/paper_color"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:background="?attr/selectableItemBackground"
        android:layout_width="match_parent"
        android:layout_height="48dp">
        <org.wikipedia.views.LangCodeView
            android:id="@+id/placesFilterLangCode"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:layout_width="48dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:paddingHorizontal="10dp"/>
        <TextView
            android:textColor="?attr/primary_color"
            android:gravity="center_vertical"
            android:id="@+id/placesFilterTitle"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            style="@style/P"/>
        <ImageView
            android:id="@+id/placesFilterRadio"
            android:padding="12dp"
            android:visibility="invisible"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_baseline_radio_button_checked_24"
            android:contentDescription="@null"
            app:tint="?attr/progressive_color"/>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:background="?attr/border_color"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"/>
</LinearLayout>
