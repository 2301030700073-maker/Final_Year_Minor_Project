<?xml version="1.0" encoding="utf-8"?>
<org.wikipedia.views.WikiCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/reading_lists_overflow_card_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="-2dp"
    android:layout_marginEnd="2dp"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:divider="?attr/list_divider"
        android:minWidth="160dp"
        android:showDividers="middle">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/reading_lists_overflow_select"
                android:text="@string/reading_list_menu_select"
                style="@style/OverflowMenuItem"/>
            <TextView
                android:id="@+id/reading_lists_overflow_sort_by"
                android:text="@string/reading_list_sort_ellipsis"
                style="@style/OverflowMenuItem"/>
            <TextView
                android:id="@+id/reading_lists_overflow_create_new_list"
                android:text="@string/reading_lists_menu_create_list"
                style="@style/OverflowMenuItem"/>
            <TextView
                android:id="@+id/reading_lists_overflow_import_list"
                android:text="@string/reading_lists_menu_import_list"
                style="@style/OverflowMenuItem"/>
        </LinearLayout>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:id="@+id/reading_lists_overflow_refresh"
            android:background="?android:attr/selectableItemBackground"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:focusable="true"
            android:clickable="true"
            android:minHeight="48dp"
            style="@style/OverflowMenuItem">
            <TextView
                android:textSize="16sp"
                android:textStyle="normal"
                android:textColor="?android:attr/textColorPrimary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reading_lists_refresh_sync_option"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?android:attr/textColorTertiary"
                android:id="@+id/reading_lists_overflow_last_sync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/reading_list_menu_last_sync"/>
        </LinearLayout>
    </LinearLayout>
</org.wikipedia.views.WikiCardView>
