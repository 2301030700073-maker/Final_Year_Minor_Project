<?xml version="1.0" encoding="utf-8"?>
<org.wikipedia.views.WikiCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_container"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:transitionName="@string/transition_search_bar"
    android:layout_marginVertical="3dp"
    app:cardCornerRadius="22dp"
    app:elevation="0dp">
    <ImageView
        android:id="@+id/search_icon"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:contentDescription="@string/search_hint"
        app:srcCompat="@drawable/ic_search_white_24dp"
        app:tint="?attr/placeholder_color"/>
    <TextView
        android:textColor="?attr/secondary_color"
        android:layout_gravity="center_vertical"
        android:id="@+id/search_text_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/search_hint"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/voice_search_button"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:contentDescription="@string/search_hint_voice_search"
        app:srcCompat="@drawable/ic_mic_black_24dp"
        app:tint="?attr/placeholder_color"/>
</org.wikipedia.views.WikiCardView>
