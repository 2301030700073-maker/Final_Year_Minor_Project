<?xml version="1.0" encoding="utf-8"?>
<org.wikipedia.views.WikiCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/overflowContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="-2dp"
    android:layout_marginEnd="2dp"
    app:cardUseCompatPadding="true">
    <LinearLayout
        android:orientation="vertical"
        android:background="?attr/paper_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="220dp">
        <TextView
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="?attr/primary_color"
            android:paddingLeft="16dp"
            android:paddingTop="13dp"
            android:paddingRight="16dp"
            android:paddingBottom="13dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/talk_overflow_sort_by"
            android:paddingHorizontal="16dp"
            android:paddingVertical="13dp"/>
        <LinearLayout
            android:id="@+id/sortByDatePublishedButton"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="16dp"
            android:paddingTop="13dp"
            android:paddingRight="16dp"
            android:paddingBottom="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="13dp">
            <ImageView
                android:id="@+id/sortByDatePublishedSelected"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_check_black_24dp"
                android:contentDescription="@null"
                android:layout_marginEnd="16dp"
                app:tint="?attr/placeholder_color"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/primary_color"
                android:id="@+id/sortByDatePublished"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/talk_overflow_sort_date_published"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/sortByDatePublishedOrder"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_baseline_arrow_right_alt_24px"
                android:contentDescription="@null"
                android:rotation="90"
                app:tint="?android:attr/textColorSecondary"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/sortByDateUpdatedButton"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="16dp"
            android:paddingTop="13dp"
            android:paddingRight="16dp"
            android:paddingBottom="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="13dp">
            <ImageView
                android:id="@+id/sortByDateUpdatedSelected"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_check_black_24dp"
                android:contentDescription="@null"
                android:layout_marginEnd="16dp"
                app:tint="?attr/placeholder_color"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/primary_color"
                android:id="@+id/sortByDateUpdated"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/talk_overflow_sort_date_updated"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/sortByDateUpdatedOrder"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_baseline_arrow_right_alt_24px"
                android:contentDescription="@null"
                android:rotation="90"
                app:tint="?attr/secondary_color"/>
        </LinearLayout>
        <LinearLayout
            android:id="@+id/sortByTopicNameButton"
            android:background="?android:attr/selectableItemBackground"
            android:paddingLeft="16dp"
            android:paddingTop="13dp"
            android:paddingRight="16dp"
            android:paddingBottom="13dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingVertical="13dp">
            <ImageView
                android:id="@+id/sortByTopicNameSelected"
                android:visibility="invisible"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_check_black_24dp"
                android:contentDescription="@null"
                android:layout_marginEnd="16dp"
                app:tint="?attr/placeholder_color"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/primary_color"
                android:id="@+id/sortByTopicName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/talk_overflow_sort_topic_name"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/sortByTopicNameOrder"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_baseline_arrow_right_alt_24px"
                android:contentDescription="@null"
                android:rotation="90"
                app:tint="?android:attr/textColorSecondary"/>
        </LinearLayout>
    </LinearLayout>
</org.wikipedia.views.WikiCardView>
