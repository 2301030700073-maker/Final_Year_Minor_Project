<?xml version="1.0" encoding="utf-8"?>
<org.wikipedia.views.WikiCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/search_container"
    android:focusable="true"
    android:clickable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:transitionName="@string/transition_search_bar"
    app:cardCornerRadius="22dp"
    app:elevation="0dp">
    <ImageView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:contentDescription="@string/watchlist_search_bar_hint"
        app:srcCompat="@drawable/ic_search_white_24dp"
        app:tint="?attr/placeholder_color"/>
    <TextView
        android:textColor="?attr/secondary_color"
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/watchlist_search_bar_hint"
        android:layout_marginStart="48dp"
        android:layout_marginEnd="48dp"/>
    <TextView
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="?attr/colorAccent"
        android:gravity="center_vertical"
        android:layout_gravity="end"
        android:id="@+id/filter_count"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginEnd="48dp"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/filter_button"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:scaleType="center"
        android:contentDescription="@string/watchlist_search_bar_filter_hint"
        app:srcCompat="@drawable/ic_baseline_tune_24"
        app:tint="?attr/primary_color"/>
</org.wikipedia.views.WikiCardView>
