<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:background="?attr/selectableItemBackground"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:contentDescription="@null"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="12dp"
        app:srcCompat="@drawable/ic_add_gray_white_24dp"
        app:tint="?attr/progressive_color"/>
    <TextView
        android:theme="@style/H3.Button"
        android:textColor="?attr/progressive_color"
        android:id="@+id/wiki_language_title"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/wikipedia_languages_add_language_text"
        android:layout_weight="1"
        android:lineSpacingExtra="8sp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"/>
</LinearLayout>
