<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <HorizontalScrollView
        android:scrollbars="none"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="1dp">
            <ImageView
                android:id="@+id/wikitext_button_h2"
                android:background="?attr/selectableItemBackground"
                android:padding="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_format_heading2_24"
                app:tint="?attr/primary_color"/>
            <ImageView
                android:id="@+id/wikitext_button_h3"
                android:background="?attr/selectableItemBackground"
                android:padding="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_format_heading3_24"
                app:tint="?attr/primary_color"/>
            <ImageView
                android:id="@+id/wikitext_button_h4"
                android:background="?attr/selectableItemBackground"
                android:padding="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_format_heading4_24"
                app:tint="?attr/primary_color"/>
            <ImageView
                android:id="@+id/wikitext_button_h5"
                android:background="?attr/selectableItemBackground"
                android:padding="12dp"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="48dp"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                app:srcCompat="@drawable/ic_format_heading5_24"
                app:tint="?attr/primary_color"/>
        </LinearLayout>
    </HorizontalScrollView>
    <View
        android:background="?attr/border_color"
        android:layout_width="match_parent"
        android:layout_height="1dp"/>
    <View
        android:layout_gravity="end"
        android:background="?attr/border_color"
        android:layout_width="1dp"
        android:layout_height="48dp"
        android:layout_marginEnd="49dp"/>
    <ImageView
        android:layout_gravity="end"
        android:id="@+id/closeButton"
        android:background="?attr/selectableItemBackground"
        android:padding="12dp"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="1dp"
        android:contentDescription="@string/table_close"
        app:srcCompat="@drawable/ic_close_black_24dp"
        app:tint="?attr/progressive_color"/>
</merge>
