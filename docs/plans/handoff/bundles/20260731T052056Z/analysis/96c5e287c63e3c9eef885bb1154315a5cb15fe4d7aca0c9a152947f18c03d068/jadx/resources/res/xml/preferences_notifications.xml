<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory android:title="@string/preference_category_push_notifications">
        <org.wikipedia.settings.PreferenceMultiLine
            android:title="@string/preference_title_customize_push_notifications"
            android:key="@string/preference_key_notification_customize_push"
            android:widgetLayout="@layout/preference_multiline_with_system_action"
            app:allowDividerAbove="true"
            app:allowDividerBelow="true"/>
    </PreferenceCategory>
    <PreferenceCategory android:title="@string/preference_category_display_settings">
        <org.wikipedia.settings.SwitchPreferenceMultiLine
            android:title="@string/preference_title_hide_read_notifications"
            android:key="@string/preference_key_notification_hide_read"
            android:defaultValue="false"
            app:allowDividerAbove="true"/>
        <Preference
            android:enabled="false"
            app:allowDividerAbove="true"/>
    </PreferenceCategory>
</PreferenceScreen>
