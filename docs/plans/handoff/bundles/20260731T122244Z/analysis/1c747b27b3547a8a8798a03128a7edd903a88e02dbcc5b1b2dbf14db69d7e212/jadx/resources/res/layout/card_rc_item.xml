<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/singleItemCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:elevation="8dp"
    app:cardBackgroundColor="@color/color2"
    app:cardCornerRadius="4dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/color2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp">
        <TextView
            android:textColor="@color/black"
            android:id="@+id/card_name"
            android:background="@color/color2"
            android:padding="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Card Name"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/color2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2">
            <ImageView
                android:id="@+id/card_pic"
                android:padding="2dp"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/ic_baseline_credit_card_24"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/color2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp">
                <TextView
                    android:textColor="@color/black"
                    android:id="@+id/card_nummber"
                    android:background="@color/color2"
                    android:padding="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Card Number"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:background="@color/color2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="3dp">
                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/Expire_date"
                        android:background="@color/color2"
                        android:padding="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Expiry date"
                        android:layout_weight="1"/>
                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/card_cvv"
                        android:background="@color/color2"
                        android:padding="3dp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="CVV"
                        android:layout_weight="1"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
