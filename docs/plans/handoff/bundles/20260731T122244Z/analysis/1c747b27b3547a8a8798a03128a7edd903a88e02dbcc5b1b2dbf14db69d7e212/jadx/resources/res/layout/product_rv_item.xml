<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/singleItemCardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:elevation="8dp"
    app:cardBackgroundColor="@color/color4"
    app:cardCornerRadius="4dp">
    <LinearLayout
        android:orientation="vertical"
        android:background="@color/color4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp">
        <TextView
            android:textColor="@color/black"
            android:id="@+id/idproductNameTV"
            android:background="@color/color4"
            android:padding="3dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Game Name"/>
        <LinearLayout
            android:orientation="horizontal"
            android:background="@color/color4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:weightSum="2">
            <ImageView
                android:id="@+id/idproductURLTV"
                android:padding="2dp"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/game1"/>
            <LinearLayout
                android:orientation="vertical"
                android:background="@color/color4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="3dp">
                <TextView
                    android:textColor="@color/black"
                    android:id="@+id/idproductDescTV"
                    android:padding="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Description"
                    android:layout_weight="1"/>
                <TextView
                    android:textColor="@color/black"
                    android:id="@+id/idproductPriceTV"
                    android:padding="3dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Price"
                    android:layout_weight="1"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
